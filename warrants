"""Warrant mispricing scanner.

Finds relative-value dislocations (extreme z-scores) and inflections
(turns / zero-crossings) of a warrant vs. its underlying common on
weekly and monthly timeframes.

Signals per timeframe:
  - ratio_z:    rolling z of log(warrant / common)
  - resid_z:    rolling z of the residual from rolling OLS
                log(warrant) ~ a + b * log(common)   (cointegration spread)
  - composite_z: average of the two
Inflections on composite_z: local peaks/troughs (find_peaks) and
zero-crossings.

Run as a Streamlit app:   cp warrants warrants_app.py && streamlit run warrants_app.py
(streamlit requires a .py extension; warrants_app.py is gitignored)
Or import as a module to reuse the pure functions.
"""
from __future__ import annotations

from urllib.parse import quote_plus

import numpy as np
import pandas as pd
import requests
import yfinance as yf
import streamlit as st
import plotly.graph_objects as go
from plotly.subplots import make_subplots
from scipy.signal import find_peaks


TIMEFRAMES = {"Weekly": "W-FRI", "Monthly": "ME"}
DEFAULT_LOOKBACK = {"Weekly": 26, "Monthly": 24}

# Common ticker conventions for U.S. warrants across Yahoo Finance.
WARRANT_SUFFIXES = [".WS", "-WT", ".WT", "W", "WS", "WT", "-WS", ".WTA", ".WTB", ".U"]

EDGAR_HEADERS = {"User-Agent": "warrant-scanner research@cyclepapa.local"}


# ---------- pure signal functions ----------

def resample_pair(df: pd.DataFrame, freq: str) -> pd.DataFrame:
    """Resample to period bars. Closes use last(); *_vol columns sum()."""
    agg = {c: ("sum" if c.endswith("_vol") else "last") for c in df.columns}
    price_cols = [c for c in df.columns if not c.endswith("_vol")]
    return df.resample(freq).agg(agg).dropna(subset=price_cols)


def rolling_zscore(s: pd.Series, lookback: int) -> pd.Series:
    mean = s.rolling(lookback).mean()
    std = s.rolling(lookback).std()
    return (s - mean) / std


def rolling_ols_residual(y: pd.Series, x: pd.Series, lookback: int):
    """Rolling OLS  y ~ alpha + beta * x.  Returns (alpha, beta, residual)."""
    cov = x.rolling(lookback).cov(y)
    var = x.rolling(lookback).var()
    beta = cov / var
    alpha = y.rolling(lookback).mean() - beta * x.rolling(lookback).mean()
    fitted = alpha + beta * x
    resid = y - fitted
    return alpha, beta, resid


def compute_signals(pair_df: pd.DataFrame, lookback: int) -> pd.DataFrame:
    """Build the signal frame for one timeframe."""
    common = pair_df["common"].astype(float)
    warrant = pair_df["warrant"].astype(float)
    log_common = np.log(common)
    log_warrant = np.log(warrant)
    log_ratio = log_warrant - log_common

    out = pd.DataFrame(index=pair_df.index)
    out["common"] = common
    out["warrant"] = warrant
    out["ratio"] = warrant / common
    out["log_ratio"] = log_ratio
    out["ratio_z"] = rolling_zscore(log_ratio, lookback)

    alpha, beta, resid = rolling_ols_residual(log_warrant, log_common, lookback)
    out["alpha"] = alpha
    out["beta"] = beta
    out["resid"] = resid
    out["resid_z"] = rolling_zscore(resid, lookback)

    out["composite_z"] = (out["ratio_z"] + out["resid_z"]) / 2
    return out


def detect_inflections(z: pd.Series, prominence: float = 0.5) -> pd.DataFrame:
    """Local peaks/troughs and sign changes of a z-score series."""
    z = z.dropna()
    if z.empty:
        return pd.DataFrame(columns=["date", "kind", "z"])
    arr = z.to_numpy()
    peaks, _ = find_peaks(arr, prominence=prominence)
    troughs, _ = find_peaks(-arr, prominence=prominence)
    sign = np.sign(arr)
    crosses = np.where(np.diff(sign) != 0)[0] + 1

    rows = []
    for i in peaks:
        rows.append({"date": z.index[i], "kind": "peak", "z": float(arr[i])})
    for i in troughs:
        rows.append({"date": z.index[i], "kind": "trough", "z": float(arr[i])})
    for i in crosses:
        rows.append({"date": z.index[i], "kind": "zero_cross", "z": float(arr[i])})
    if not rows:
        return pd.DataFrame(columns=["date", "kind", "z"])
    return pd.DataFrame(rows).sort_values("date").reset_index(drop=True)


def compute_volume_signals(df: pd.DataFrame, lookback: int) -> pd.DataFrame:
    """Volume z-scores. Requires *_vol columns from yfinance Volume."""
    out = pd.DataFrame(index=df.index)
    if "warrant_vol" in df.columns and "warrant" in df.columns:
        wvol = df["warrant_vol"].astype(float).replace(0, np.nan)
        out["warrant_vol"] = wvol
        out["warrant_vol_z"] = rolling_zscore(np.log(wvol), lookback)
        out["warrant_relvol"] = wvol / wvol.rolling(lookback).median()
        dollar = wvol * df["warrant"]
        out["warrant_dollar_vol"] = dollar
        out["warrant_dollar_vol_z"] = rolling_zscore(
            np.log(dollar.replace(0, np.nan)), lookback)
    if "common_vol" in df.columns:
        cvol = df["common_vol"].astype(float).replace(0, np.nan)
        out["common_vol"] = cvol
        out["common_vol_z"] = rolling_zscore(np.log(cvol), lookback)
        if "warrant_vol" in df.columns:
            ratio = (df["warrant_vol"].replace(0, np.nan) / cvol)
            out["w2c_vol"] = ratio
            out["w2c_vol_z"] = rolling_zscore(np.log(ratio), lookback)
    return out


def detect_volume_anomalies(sig: pd.DataFrame, threshold: float = 2.0,
                            lookback: int = 12) -> pd.DataFrame:
    """Bars where any volume z-score breaches threshold (absolute)."""
    cols = [c for c in ("warrant_vol_z", "warrant_dollar_vol_z", "w2c_vol_z")
            if c in sig.columns]
    rows = []
    for c in cols:
        s = sig[c].dropna()
        for d, v in s[s.abs() >= threshold].items():
            rows.append({"date": d, "metric": c, "z": float(v)})
    if not rows:
        return pd.DataFrame(columns=["date", "metric", "z"])
    return pd.DataFrame(rows).sort_values(["date", "metric"]).reset_index(drop=True)


def _joint_z(price_z: pd.Series, vol_z: pd.Series, vol_weight: float = 0.5) -> pd.Series:
    """price dislocation amplified by *confirming* volume.

    joint = price_z + vol_weight * max(vol_z, 0) * sign(price_z)

    Idea: a price dislocation is much more actionable when accompanied
    by an unusual volume print — volume confirms the move. Quiet
    dislocations get the original price_z; loud dislocations get bigger.
    """
    if vol_z is None or vol_z.isna().all():
        return price_z
    confirm = vol_z.fillna(0).clip(lower=0)
    return price_z + vol_weight * np.sign(price_z) * confirm


def scan_pair(pair_df: pd.DataFrame, lookbacks: dict | None = None,
              prominence: float = 0.5, vol_weight: float = 0.5) -> dict:
    """Run the scan across all timeframes.

    Returns {tf: {signals, inflections, vol_anomalies}}. signals includes
    price z-scores, volume z-scores (if Volume present), and joint_z.
    """
    lookbacks = lookbacks or DEFAULT_LOOKBACK
    out = {}
    for tf_name, freq in TIMEFRAMES.items():
        resampled = resample_pair(pair_df, freq)
        if len(resampled) < lookbacks[tf_name] + 2:
            continue
        price_sig = compute_signals(resampled, lookbacks[tf_name])
        vol_sig = compute_volume_signals(resampled, lookbacks[tf_name])
        merged = pd.concat([price_sig, vol_sig], axis=1)
        vz = merged["w2c_vol_z"] if "w2c_vol_z" in merged.columns \
            else merged.get("warrant_vol_z")
        merged["joint_z"] = _joint_z(merged["composite_z"], vz,
                                     vol_weight=vol_weight)
        infl = detect_inflections(merged["joint_z"], prominence=prominence)
        vol_anom = detect_volume_anomalies(merged, threshold=2.0)
        out[tf_name] = {"signals": merged, "inflections": infl,
                        "vol_anomalies": vol_anom}
    return out


def summarize(scan: dict) -> pd.DataFrame:
    """Latest reading per timeframe."""
    rows = []

    def _g(last, key, ndigits=2):
        v = last.get(key, np.nan) if hasattr(last, "get") else np.nan
        try:
            v = float(v)
        except Exception:
            return None
        if np.isnan(v):
            return None
        return round(v, ndigits)

    for tf, payload in scan.items():
        sig = payload["signals"].dropna(subset=["composite_z"])
        if sig.empty:
            continue
        last = sig.iloc[-1]
        infl = payload["inflections"]
        last_infl = infl.iloc[-1] if not infl.empty else None
        vol_anom = payload.get("vol_anomalies", pd.DataFrame())
        last_vol = vol_anom.iloc[-1] if not vol_anom.empty else None
        z = float(last["composite_z"])
        jz = float(last.get("joint_z", z)) if not pd.isna(last.get("joint_z", z)) else z
        regime = "rich" if jz > 1 else ("cheap" if jz < -1 else "neutral")
        rows.append({
            "timeframe": tf,
            "as_of": sig.index[-1].date(),
            "ratio_z": _g(last, "ratio_z"),
            "resid_z": _g(last, "resid_z"),
            "composite_z": round(z, 2),
            "warrant_vol_z": _g(last, "warrant_vol_z"),
            "w2c_vol_z": _g(last, "w2c_vol_z"),
            "warrant_relvol": _g(last, "warrant_relvol"),
            "joint_z": round(jz, 2),
            "beta": _g(last, "beta", 3),
            "regime": regime,
            "last_inflection": last_infl["date"].date() if last_infl is not None else None,
            "last_inflection_kind": last_infl["kind"] if last_infl is not None else None,
            "last_vol_anom": last_vol["date"].date() if last_vol is not None else None,
        })
    return pd.DataFrame(rows)


# ---------- data loading ----------

def load_pair_yf(common_ticker: str, warrant_ticker: str,
                 period: str = "5y") -> pd.DataFrame:
    """Pull daily Close + Volume for both legs from Yahoo and align.

    Returns columns: common, warrant, common_vol, warrant_vol.
    """
    data = yf.download(
        [common_ticker, warrant_ticker],
        period=period,
        auto_adjust=True,
        progress=False,
        group_by="column",
    )
    if isinstance(data.columns, pd.MultiIndex):
        close = data["Close"]
        vol = data["Volume"] if "Volume" in data.columns.get_level_values(0) \
            else pd.DataFrame(index=close.index)
    else:
        close = data[["Close"]].copy(); close.columns = [common_ticker]
        vol = data[["Volume"]].copy() if "Volume" in data.columns \
            else pd.DataFrame(index=close.index)
        if not vol.empty:
            vol.columns = [common_ticker]
    out = pd.DataFrame({
        "common": close.get(common_ticker),
        "warrant": close.get(warrant_ticker),
        "common_vol": vol.get(common_ticker),
        "warrant_vol": vol.get(warrant_ticker),
    }).dropna(subset=["common", "warrant"])
    return out


# ---------- universe (financedatabase) ----------

@st.cache_data(ttl=24 * 3600, show_spinner=False)
def load_smallcap_universe(country: str = "United States",
                           market_caps=("Small Cap", "Micro Cap")) -> pd.DataFrame:
    """Approximate Russell 2000 via financedatabase small/micro caps."""
    try:
        import financedatabase as fd
    except ImportError as e:
        raise RuntimeError(
            "financedatabase not installed — run `pip install financedatabase`"
        ) from e
    eq = fd.Equities()
    df = eq.select(country=country, market_cap=list(market_caps))
    df = df.dropna(subset=["name"]).reset_index()
    sym_col = "symbol" if "symbol" in df.columns else df.columns[0]
    df = df.rename(columns={sym_col: "common"})
    keep = [c for c in ["common", "name", "sector", "industry", "market_cap", "exchange"]
            if c in df.columns]
    return df[keep]


# ---------- warrant discovery (yfinance suffix probing) ----------

@st.cache_data(ttl=7 * 24 * 3600, show_spinner=False)
def _yf_has_data(ticker: str, min_bars: int = 60) -> bool:
    try:
        df = yf.download(ticker, period="6mo", progress=False,
                         auto_adjust=True, threads=False)
        if df is None or df.empty:
            return False
        if isinstance(df.columns, pd.MultiIndex):
            df = df.xs("Close", axis=1, level=0, drop_level=True) \
                if "Close" in df.columns.get_level_values(0) else df
        return len(df.dropna(how="all")) >= min_bars
    except Exception:
        return False


def discover_warrant(common: str, suffixes=WARRANT_SUFFIXES) -> str | None:
    """Try ticker suffix conventions; return first that has Yahoo data."""
    for suf in suffixes:
        candidate = f"{common}{suf}"
        if _yf_has_data(candidate):
            return candidate
    return None


def discover_warrants_for(commons: list[str], limit: int | None = None,
                          progress_cb=None) -> pd.DataFrame:
    rows = []
    sl = commons[:limit] if limit else commons
    for i, c in enumerate(sl):
        w = discover_warrant(c)
        rows.append({"common": c, "warrant": w})
        if progress_cb:
            progress_cb((i + 1) / len(sl), c, w)
    return pd.DataFrame(rows)


# ---------- batch scan ----------

def batch_load_pairs(tickers: list[str], period: str = "5y") -> dict:
    """One yfinance call for many tickers; returns {'close': df, 'volume': df}."""
    tickers = sorted(set(tickers))
    data = yf.download(tickers, period=period, auto_adjust=True,
                       progress=False, group_by="column", threads=True)
    if data is None or data.empty:
        return {"close": pd.DataFrame(), "volume": pd.DataFrame()}
    if isinstance(data.columns, pd.MultiIndex):
        levels = data.columns.get_level_values(0)
        close = data["Close"] if "Close" in levels else pd.DataFrame()
        volume = data["Volume"] if "Volume" in levels else pd.DataFrame()
    else:
        close = data[["Close"]].copy() if "Close" in data.columns else pd.DataFrame()
        if not close.empty:
            close.columns = tickers
        volume = data[["Volume"]].copy() if "Volume" in data.columns else pd.DataFrame()
        if not volume.empty:
            volume.columns = tickers
    return {"close": close, "volume": volume}


def batch_scan(pairs: list[tuple[str, str]], period: str = "5y",
               lookbacks: dict | None = None,
               prominence: float = 0.5,
               vol_weight: float = 0.5) -> tuple[pd.DataFrame, dict]:
    """Scan many (common, warrant) pairs. Returns (summary_df, details_dict)."""
    pairs = [(c, w) for c, w in pairs if c and w]
    if not pairs:
        return pd.DataFrame(), {}
    universe = [t for pair in pairs for t in pair]
    bundle = batch_load_pairs(universe, period=period)
    closes, vols = bundle["close"], bundle["volume"]
    summaries = []
    details = {}
    for common, warrant in pairs:
        if common not in closes.columns or warrant not in closes.columns:
            continue
        cols = {"common": closes[common], "warrant": closes[warrant]}
        if not vols.empty and common in vols.columns:
            cols["common_vol"] = vols[common]
        if not vols.empty and warrant in vols.columns:
            cols["warrant_vol"] = vols[warrant]
        df = pd.DataFrame(cols).dropna(subset=["common", "warrant"])
        if len(df) < 60:
            continue
        try:
            scan = scan_pair(df, lookbacks=lookbacks, prominence=prominence,
                             vol_weight=vol_weight)
        except Exception:
            continue
        if not scan:
            continue
        s = summarize(scan)
        if s.empty:
            continue
        s.insert(0, "pair", f"{warrant}/{common}")
        s.insert(1, "common", common)
        s.insert(2, "warrant", warrant)
        summaries.append(s)
        details[(common, warrant)] = scan
    summary = pd.concat(summaries, ignore_index=True) if summaries else pd.DataFrame()
    return summary, details


def rank_dislocations(summary: pd.DataFrame, by: str = "joint_z") -> pd.DataFrame:
    """One row per pair, max |z| across timeframes on the chosen metric."""
    if summary.empty or by not in summary.columns:
        by = "composite_z" if "composite_z" in summary.columns else None
    if by is None:
        return summary
    s = summary.dropna(subset=[by]).copy()
    s["abs_z"] = s[by].abs()
    idx = s.groupby("pair")["abs_z"].idxmax()
    return s.loc[idx].sort_values("abs_z", ascending=False).reset_index(drop=True)


# ---------- EDGAR ----------

@st.cache_data(ttl=24 * 3600, show_spinner=False)
def sec_ticker_map() -> dict:
    """Yahoo-style ticker (uppercase) → 10-digit CIK."""
    r = requests.get("https://www.sec.gov/files/company_tickers.json",
                     headers=EDGAR_HEADERS, timeout=15)
    r.raise_for_status()
    j = r.json()
    return {row["ticker"].upper(): str(row["cik_str"]).zfill(10) for row in j.values()}


def ticker_to_cik(ticker: str) -> str | None:
    return sec_ticker_map().get(ticker.upper())


@st.cache_data(ttl=24 * 3600, show_spinner=False)
def edgar_recent_filings(cik: str, forms: tuple[str, ...] | None = None,
                        limit: int = 25) -> pd.DataFrame:
    """Pull the most recent filings index for a CIK."""
    url = f"https://data.sec.gov/submissions/CIK{cik}.json"
    r = requests.get(url, headers=EDGAR_HEADERS, timeout=15)
    r.raise_for_status()
    j = r.json()
    rec = j["filings"]["recent"]
    df = pd.DataFrame({
        "form": rec["form"],
        "filed": rec["filingDate"],
        "accession": rec["accessionNumber"],
        "primary": rec["primaryDocument"],
        "description": rec["primaryDocDescription"],
    })
    if forms:
        df = df[df["form"].isin(forms)]
    df["url"] = df.apply(
        lambda r: (f"https://www.sec.gov/Archives/edgar/data/"
                   f"{int(cik)}/{r['accession'].replace('-', '')}/"
                   f"{r['primary']}"), axis=1)
    return df.head(limit).reset_index(drop=True)


def edgar_fulltext_search_url(query: str,
                              forms: str = "10-K,10-Q,8-K,S-1,8-A12B") -> str:
    """Convenience link to EDGAR full-text search (for warrant terms)."""
    return ("https://efts.sec.gov/LATEST/search-index"
            f"?q={quote_plus(query)}&forms={quote_plus(forms)}")


# ---------- option vs. warrant parity (the GME case) ----------

def option_warrant_parity(common_ticker: str, warrant_price: float,
                          strike: float, expiry: str,
                          warrant_ratio: float = 1.0,
                          dilution_factor: float = 1.0) -> dict:
    """Compare a warrant's market price to the listed call at the same
    strike & expiry. Theoretical fair value of one warrant:

        warrant ≈ warrant_ratio * dilution_factor * call_mid

    warrant_ratio  = shares delivered per warrant exercised (often 1.0,
                     sometimes 0.5 for SPAC-style 2:1 warrants)
    dilution_factor = N_shares / (N_shares + N_warrants_outstanding * ratio)
                      (1.0 if dilution is immaterial / already in float)
    """
    t = yf.Ticker(common_ticker)
    expiries = list(t.options or [])
    if not expiries:
        return {"error": f"no listed options for {common_ticker}"}
    target = pd.Timestamp(expiry)
    closest = min(expiries, key=lambda e: abs(pd.Timestamp(e) - target))
    chain = t.option_chain(closest).calls
    if chain is None or chain.empty:
        return {"error": f"empty call chain at {closest}"}
    row = chain.iloc[(chain["strike"] - strike).abs().argmin()]
    bid, ask, last = float(row["bid"]), float(row["ask"]), float(row["lastPrice"])
    call_mid = (bid + ask) / 2 if bid > 0 and ask > 0 else last
    theoretical = warrant_ratio * dilution_factor * call_mid
    gap = warrant_price - theoretical
    gap_pct = (gap / theoretical) if theoretical else float("nan")
    if gap_pct < -0.05:
        verdict = "WARRANT CHEAP vs. listed call (potential long warrant / short call)"
    elif gap_pct > 0.05:
        verdict = "WARRANT RICH vs. listed call (potential short warrant / long call)"
    else:
        verdict = "near parity"
    return {
        "common": common_ticker,
        "warrant_price": warrant_price,
        "target_strike": strike,
        "target_expiry": expiry,
        "matched_expiry": closest,
        "matched_strike": float(row["strike"]),
        "call_bid": bid,
        "call_ask": ask,
        "call_last": last,
        "call_mid": float(call_mid),
        "warrant_ratio": warrant_ratio,
        "dilution_factor": dilution_factor,
        "theoretical_warrant": float(theoretical),
        "gap": float(gap),
        "gap_pct": float(gap_pct),
        "verdict": verdict,
    }


# ---------- Streamlit UI ----------

def _plot(sig: pd.DataFrame, infl: pd.DataFrame, title: str) -> go.Figure:
    has_vol = "warrant_vol" in sig.columns
    rows = 4 if has_vol else 3
    heights = [0.28, 0.22, 0.22, 0.28] if has_vol else [0.35, 0.3, 0.35]
    titles = [f"{title} — prices", "log(warrant/common)"]
    if has_vol:
        titles.append("volume z-scores")
    titles.append("price z-scores (composite + joint)")
    fig = make_subplots(rows=rows, cols=1, shared_xaxes=True,
                        row_heights=heights, subplot_titles=titles,
                        vertical_spacing=0.05)
    fig.add_trace(go.Scatter(x=sig.index, y=sig["common"], name="common"),
                  row=1, col=1)
    fig.add_trace(go.Scatter(x=sig.index, y=sig["warrant"], name="warrant"),
                  row=1, col=1)
    fig.add_trace(go.Scatter(x=sig.index, y=sig["log_ratio"], name="log ratio"),
                  row=2, col=1)

    z_row = 4 if has_vol else 3
    if has_vol:
        if "warrant_vol_z" in sig.columns:
            fig.add_trace(go.Scatter(x=sig.index, y=sig["warrant_vol_z"],
                                     name="warrant vol z"), row=3, col=1)
        if "w2c_vol_z" in sig.columns:
            fig.add_trace(go.Scatter(x=sig.index, y=sig["w2c_vol_z"],
                                     name="warrant/common vol z",
                                     line=dict(width=2)), row=3, col=1)
        fig.add_hline(y=2, line_dash="dot", line_color="orange", row=3, col=1)
        fig.add_hline(y=-2, line_dash="dot", line_color="orange", row=3, col=1)

    fig.add_trace(go.Scatter(x=sig.index, y=sig["ratio_z"], name="ratio z",
                             line=dict(dash="dot")), row=z_row, col=1)
    fig.add_trace(go.Scatter(x=sig.index, y=sig["resid_z"], name="resid z",
                             line=dict(dash="dash")), row=z_row, col=1)
    fig.add_trace(go.Scatter(x=sig.index, y=sig["composite_z"],
                             name="composite z", line=dict(width=2)),
                  row=z_row, col=1)
    if "joint_z" in sig.columns:
        fig.add_trace(go.Scatter(x=sig.index, y=sig["joint_z"],
                                 name="joint z (price+vol)",
                                 line=dict(width=3, color="purple")),
                      row=z_row, col=1)

    if not infl.empty:
        for kind, sym, color in [("peak", "triangle-down", "red"),
                                 ("trough", "triangle-up", "green"),
                                 ("zero_cross", "x", "grey")]:
            sub = infl[infl["kind"] == kind]
            if not sub.empty:
                fig.add_trace(go.Scatter(
                    x=sub["date"], y=sub["z"], mode="markers", name=kind,
                    marker=dict(symbol=sym, size=10, color=color),
                ), row=z_row, col=1)

    fig.add_hline(y=2, line_dash="dot", line_color="red", row=z_row, col=1)
    fig.add_hline(y=-2, line_dash="dot", line_color="green", row=z_row, col=1)
    fig.add_hline(y=0, line_dash="dash", line_color="grey", row=z_row, col=1)
    fig.update_layout(height=850 if has_vol else 750, showlegend=True,
                      hovermode="x unified")
    return fig


def _pair_tab(lookback_w: int, lookback_m: int, prominence: float, z_alert: float):
    st.subheader("Single pair scan")
    source = st.radio("Data source", ["Yahoo Finance", "Upload CSV"],
                      horizontal=True, key="pair_source")

    pair_df = st.session_state.get("pair_df")
    pair_name = st.session_state.get("pair_name")

    if source == "Yahoo Finance":
        c1, c2, c3, c4 = st.columns([2, 2, 1, 1])
        common_ticker = c1.text_input("Common ticker", value="LCID",
                                      key="pair_common")
        warrant_ticker = c2.text_input("Warrant ticker", value="LCIDW",
                                       key="pair_warrant")
        period = c3.selectbox("History", ["1y", "2y", "5y", "10y", "max"],
                              index=2, key="pair_period")
        if c4.button("Fetch", use_container_width=True, key="pair_fetch"):
            try:
                pair_df = load_pair_yf(common_ticker, warrant_ticker,
                                       period=period)
                pair_name = f"{warrant_ticker} vs {common_ticker}"
                st.session_state["pair_df"] = pair_df
                st.session_state["pair_name"] = pair_name
            except Exception as e:
                st.error(f"Fetch failed: {e}")
    else:
        upl = st.file_uploader("CSV with columns: date, common, warrant",
                               type="csv", key="pair_upload")
        if upl is not None:
            df = pd.read_csv(upl)
            date_col = next((c for c in df.columns
                             if c.lower() in ("date", "time")),
                            df.columns[0])
            df[date_col] = pd.to_datetime(df[date_col])
            df = df.set_index(date_col).sort_index()
            pair_df = df[["common", "warrant"]].dropna()
            pair_name = upl.name
            st.session_state["pair_df"] = pair_df
            st.session_state["pair_name"] = pair_name

    if pair_df is None or pair_df.empty:
        st.info("Load a pair to begin.")
        return

    st.subheader(f"Pair: {pair_name}")
    st.write(f"Daily bars: {len(pair_df)} — {pair_df.index[0].date()} → "
             f"{pair_df.index[-1].date()}")

    scan = scan_pair(pair_df,
                     lookbacks={"Weekly": lookback_w, "Monthly": lookback_m},
                     prominence=prominence)
    if not scan:
        st.warning("Not enough data for the chosen lookbacks.")
        return

    summary = summarize(scan)
    st.subheader("Current readings")
    st.dataframe(summary, use_container_width=True)

    hot = summary[summary["composite_z"].abs() >= z_alert]
    if not hot.empty:
        st.error("ALERT — dislocation thresholds breached:")
        st.dataframe(hot, use_container_width=True)

    for tf, payload in scan.items():
        st.markdown(f"### {tf} timeframe")
        sig = payload["signals"]
        infl = payload["inflections"]
        vol_anom = payload.get("vol_anomalies", pd.DataFrame())
        st.plotly_chart(_plot(sig, infl, tf), use_container_width=True)
        c_l, c_r = st.columns(2)
        with c_l.expander(f"{tf} price inflections ({len(infl)})"):
            st.dataframe(infl.iloc[::-1], use_container_width=True)
        with c_r.expander(f"{tf} volume anomalies ({len(vol_anom)})"):
            st.dataframe(vol_anom.iloc[::-1], use_container_width=True)
        with st.expander(f"{tf} signal frame"):
            st.dataframe(sig.iloc[::-1].head(60), use_container_width=True)


def _screener_tab(lookback_w: int, lookback_m: int, prominence: float,
                  z_alert: float):
    st.subheader("Universe screener (R2K proxy via financedatabase)")
    st.caption("Pulls small/micro-cap U.S. equities, probes Yahoo for "
               "warrant tickers via common suffixes, then runs the same "
               "weekly+monthly scan in batch.")

    mode = st.radio(
        "Universe source",
        ["financedatabase (small/micro cap US)", "Paste commons",
         "Paste pairs", "Upload pair CSV"],
        horizontal=False, key="screen_mode",
    )

    c1, c2, c3, c4 = st.columns(4)
    limit = int(c1.number_input("Max commons to probe", 5, 2500, 100,
                                key="screen_limit"))
    period = c2.selectbox("History", ["1y", "2y", "5y", "10y"], index=2,
                          key="screen_period")
    rank_by = c3.selectbox("Rank by",
                           ["joint_z", "composite_z", "warrant_vol_z",
                            "w2c_vol_z"], index=0, key="screen_rank_by")
    min_abs_z = float(c4.number_input(f"Show |{rank_by}| ≥", 0.0, 5.0, 1.5,
                                       0.1, key="screen_min_z"))

    pairs: list[tuple[str, str]] = []
    pairs_df: pd.DataFrame | None = None

    if mode == "financedatabase (small/micro cap US)":
        if st.button("Discover warrants", key="discover_btn"):
            try:
                with st.spinner("Loading universe..."):
                    uni = load_smallcap_universe()
                st.write(f"Universe size: {len(uni)} — probing first "
                         f"{limit}.")
                prog = st.progress(0.0)
                status = st.empty()

                def _cb(p, c, w):
                    prog.progress(p)
                    status.write(f"{c} → {w or 'no warrant found'}")

                pairs_df = discover_warrants_for(
                    uni["common"].dropna().astype(str).tolist(),
                    limit=limit, progress_cb=_cb,
                )
                pairs_df = pairs_df.dropna(subset=["warrant"])
                st.session_state["screen_pairs_df"] = pairs_df
                status.write(f"Found {len(pairs_df)} pairs with warrant data.")
            except Exception as e:
                st.error(f"Universe step failed: {e}")
        pairs_df = st.session_state.get("screen_pairs_df")

    elif mode == "Paste commons":
        raw = st.text_area(
            "Common tickers (one per line or comma-separated)",
            value="GME\nLCID\nBARK\nASTS\nDNA",
            key="screen_commons",
        )
        commons = [t.strip().upper() for t in raw.replace(",", "\n").splitlines()
                   if t.strip()]
        if st.button("Discover warrants", key="discover_commons_btn"):
            prog = st.progress(0.0)
            status = st.empty()

            def _cb(p, c, w):
                prog.progress(p)
                status.write(f"{c} → {w or 'no warrant found'}")

            pairs_df = discover_warrants_for(commons, limit=limit,
                                             progress_cb=_cb)
            pairs_df = pairs_df.dropna(subset=["warrant"])
            st.session_state["screen_pairs_df"] = pairs_df
        pairs_df = st.session_state.get("screen_pairs_df")

    elif mode == "Paste pairs":
        raw = st.text_area(
            "Pairs as common,warrant (one per line)",
            value="GME,GME-WT\nLCID,LCIDW\nBARK,BARK-WS",
            key="screen_pairs_text",
        )
        rows = []
        for line in raw.splitlines():
            parts = [p.strip() for p in line.split(",")]
            if len(parts) >= 2 and parts[0] and parts[1]:
                rows.append({"common": parts[0].upper(),
                             "warrant": parts[1].upper()})
        pairs_df = pd.DataFrame(rows) if rows else None

    elif mode == "Upload pair CSV":
        upl = st.file_uploader("CSV with columns: common,warrant", type="csv",
                               key="screen_csv")
        if upl is not None:
            pairs_df = pd.read_csv(upl)
            pairs_df.columns = [c.lower() for c in pairs_df.columns]
            pairs_df = pairs_df[["common", "warrant"]].dropna()

    if pairs_df is None or pairs_df.empty:
        st.info("Pick a universe source and load pairs to begin.")
        return

    st.dataframe(pairs_df, use_container_width=True, height=200)

    if st.button("Run batch scan", type="primary", key="run_batch"):
        pairs = [(r["common"], r["warrant"]) for _, r in pairs_df.iterrows()]
        with st.spinner(f"Scanning {len(pairs)} pairs..."):
            summary, details = batch_scan(
                pairs, period=period,
                lookbacks={"Weekly": lookback_w, "Monthly": lookback_m},
                prominence=prominence,
            )
        st.session_state["screen_summary"] = summary
        st.session_state["screen_details"] = details

    summary = st.session_state.get("screen_summary")
    details = st.session_state.get("screen_details", {})
    if summary is None or summary.empty:
        return

    ranked = rank_dislocations(summary, by=rank_by)
    if min_abs_z > 0 and "abs_z" in ranked.columns:
        ranked = ranked[ranked["abs_z"] >= min_abs_z]
    st.subheader(f"Top dislocations by {rank_by} ({len(ranked)})")
    st.dataframe(ranked, use_container_width=True)

    st.subheader("All TF rows")
    st.dataframe(summary, use_container_width=True)

    pick = st.selectbox("Drill into a pair", [""] + list(details.keys()),
                        format_func=lambda x: f"{x[1]}/{x[0]}" if x else "")
    if pick:
        for tf, payload in details[pick].items():
            st.markdown(f"### {pick[1]}/{pick[0]} — {tf}")
            st.plotly_chart(_plot(payload["signals"],
                                  payload["inflections"], tf),
                            use_container_width=True)


def _parity_tab():
    st.subheader("Option vs. warrant parity (model-free arb check)")
    st.caption("Compare a warrant's market price to the listed call at "
               "the same strike & expiry. Theoretical: "
               "`warrant ≈ ratio × dilution × call_mid`.")

    c1, c2, c3, c4 = st.columns(4)
    common = c1.text_input("Common ticker", value="GME", key="par_common")
    warrant_ticker = c2.text_input("Warrant ticker (optional, for live px)",
                                   value="GME-WT", key="par_warrant")
    strike = float(c3.number_input("Warrant strike", value=32.0, step=0.5,
                                    key="par_strike"))
    expiry = c4.text_input("Warrant expiry (YYYY-MM-DD)", value="2032-06-15",
                           key="par_expiry")

    c5, c6, c7 = st.columns(3)
    warrant_ratio = float(c5.number_input("Shares per warrant", value=1.0,
                                          step=0.1, key="par_ratio"))
    dilution = float(c6.number_input("Dilution factor", value=1.0, step=0.01,
                                     min_value=0.0, max_value=1.0,
                                     key="par_dilution"))
    warrant_px_override = c7.number_input(
        "Warrant price (override, 0 = auto)", value=0.0, step=0.01,
        key="par_px",
    )

    if st.button("Check parity", type="primary", key="par_run"):
        warrant_px = float(warrant_px_override)
        if warrant_px <= 0 and warrant_ticker:
            try:
                hist = yf.Ticker(warrant_ticker).history(period="5d")
                if not hist.empty:
                    warrant_px = float(hist["Close"].iloc[-1])
            except Exception as e:
                st.warning(f"Could not fetch warrant price: {e}")
        if warrant_px <= 0:
            st.error("Provide a warrant price (override or valid ticker).")
            return
        try:
            res = option_warrant_parity(
                common_ticker=common, warrant_price=warrant_px,
                strike=strike, expiry=expiry,
                warrant_ratio=warrant_ratio, dilution_factor=dilution,
            )
        except Exception as e:
            st.error(f"Parity check failed: {e}")
            return
        if "error" in res:
            st.error(res["error"])
            return
        gap_pct = res["gap_pct"]
        if gap_pct < -0.05:
            st.error(f"**{res['verdict']}** — gap {gap_pct:.1%}")
        elif gap_pct > 0.05:
            st.warning(f"**{res['verdict']}** — gap {gap_pct:.1%}")
        else:
            st.success(f"**{res['verdict']}** — gap {gap_pct:.1%}")
        st.json(res)


