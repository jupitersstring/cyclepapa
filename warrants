@_cache(ttl=24 * 3600, show_spinner=False)
def load_smallcap_universe(country: str = "United States",
                           market_caps=("Small Cap", "Micro Cap")) -> pd.DataFrame:
    """Approximate Russell 2000 via financedatabase small/micro caps."""
    try:
        import financedatabase as fd
    except ImportError as e:
        raise RuntimeError(
            "financedatabase not installed — run `pip install financedatabase`"
        ) from e
    eq = fd.Equities()
    df = eq.select(country=country, market_cap=list(market_caps))
    df = df.dropna(subset=["name"]).reset_index()
    sym_col = "symbol" if "symbol" in df.columns else df.columns[0]
    df = df.rename(columns={sym_col: "common"})
    keep = [c for c in ["common", "name", "sector", "industry", "market_cap", "exchange"]
            if c in df.columns]
    return df[keep]


_TSX_BOARDS = ("tsx", "tsxv")
TSX_COMMON_SUFFIX = {"TSX": ".TO", "TSXV": ".V"}
TSX_WARRANT_SUFFIXES = (".WT.TO", ".WS.TO", ".WTA.TO", ".UN.TO",
                        ".WT.V", ".WS.V", ".WTA.V")


@_cache(ttl=24 * 3600, show_spinner=False)
def fetch_tsx_companies() -> pd.DataFrame:
    """All TSX + TSXV listed companies (alphabetic crawl of the public directory)."""
    rows = []
    for board in _TSX_BOARDS:
        for letter in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
            try:
                r = requests.get(
                    f"https://www.tsx.com/json/company-directory/search/"
                    f"{board}/{letter}",
                    headers=EDGAR_HEADERS, timeout=15,
                )
                if not r.ok:
                    continue
                for row in r.json().get("results", []):
                    sym = row.get("symbol")
                    name = row.get("name")
                    if sym:
                        rows.append({"symbol": sym, "name": name,
                                     "board": board.upper()})
            except Exception:
                continue
    return (pd.DataFrame(rows).dropna(subset=["symbol"])
            .drop_duplicates(subset=["symbol", "board"])
            .reset_index(drop=True))


def discover_tsx_warrants(companies: pd.DataFrame | None = None,
                           chunk_size: int = 250,
                           min_bars: int = 30,
                           max_stale_days: int = 45) -> pd.DataFrame:
    """Batch-probe Yahoo for TSX/TSXV warrant tickers.

    Generates `<symbol><suffix>` candidates for each company, downloads
    them in chunks via the batch endpoint, and keeps the ones with
    recent data. Much faster than per-ticker probing.
    """
    if companies is None:
        companies = fetch_tsx_companies()
    if companies.empty:
        return pd.DataFrame(columns=["common", "warrant", "name", "exchange"])
    candidates = []
    for _, row in companies.iterrows():
        for sfx in TSX_WARRANT_SUFFIXES:
            board = row["board"]
            if (sfx.endswith(".TO") and board == "TSX") or \
               (sfx.endswith(".V") and board == "TSXV"):
                candidates.append((f"{row['symbol']}{sfx}", row))
    out = []
    cutoff = pd.Timestamp.utcnow().tz_localize(None) - \
        pd.Timedelta(days=max_stale_days)
    for i in range(0, len(candidates), chunk_size):
        batch = candidates[i:i + chunk_size]
        bundle = batch_load_pairs([c[0] for c in batch], period="6mo")
        closes = bundle["close"]
        if closes.empty:
            continue
        for ticker, row in batch:
            if ticker not in closes.columns:
                continue
            s = closes[ticker].dropna()
            if len(s) < min_bars:
                continue
            last = s.index[-1].tz_localize(None) if s.index.tz is not None \
                else s.index[-1]
            if last < cutoff:
                continue
            board = row["board"]
            common_y = f"{row['symbol']}{TSX_COMMON_SUFFIX[board]}"
            out.append({"common": common_y, "warrant": ticker,
                        "name": row["name"], "exchange": board})
    return pd.DataFrame(out).drop_duplicates(subset=["warrant"]) \
                            .reset_index(drop=True)


