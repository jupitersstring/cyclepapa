    s.add_argument("--refresh-universe", action="store_true",
                  help="Re-fetch NASDAQ Trader and rewrite the universe CSV.")
    s.add_argument("--max-stale-days", type=int, default=30)
    s.add_argument("--period", default="1y")
    s.add_argument("--strike", type=float, default=11.50)
    s.add_argument("--T", type=float, default=3.0)
    s.add_argument("--r", type=float, default=0.045)
    s.add_argument("--dilution", type=float, default=0.90)
    s.add_argument("--gap", type=float, default=-0.50)
    s.add_argument("--money", type=float, default=0.85)
    s.add_argument("--score-n", type=int, default=60,
                  help="Max names to pull fundamentals for.")
    s.add_argument("--top", type=int, default=15)
    s.add_argument("--resolve-edgar", action="store_true",
                  help="Resolve each pair's strike from EDGAR (S-1/S-3/424B5/8-A12B). "
                  "Slow on first run (~1s/name), cached after. Without this, "
                  "uses --strike default and split-adjusts.")
    s.add_argument("--min-dvol", type=float, default=0.0,
                  help="Optional: drop pairs below this 5-day avg dollar volume. "
                  "Default 0 (off) — yfinance volume is incomplete for many "
                  "warrant tickers, so absence of prints doesn't mean absence "
                  "of a tradeable market.")
    s.add_argument("--min-days-traded", type=int, default=0,
                  help="Optional: require this many of last 5 sessions with "
                  "non-zero volume per yfinance. Default 0 (off).")
    s.add_argument("--out", default=None)
    s.set_defaults(fn=_cmd_opportunities)

    # flow — unusual-volume screen
    s = sub.add_parser("flow", help="Suspicious volume on warrants (recent surge vs baseline).")
    s.add_argument("--pairs", default="warrants_universe.csv")
    s.add_argument("--period", default="3mo",
                  help="History window for the baseline computation.")
    s.add_argument("--min-dvol", type=float, default=1000.0,
                  help="Minimum 5d avg dollar volume to consider (drops "
                  "names with no real activity).")
    s.add_argument("--sort", default="surge_5d",
                  choices=["surge_5d", "surge_1d", "vol_z_1d",
                           "w2c_surge", "dvol_5d", "px_5d_chg"])
    s.add_argument("--top", type=int, default=25)
    s.add_argument("--out", default=None)
    s.set_defaults(fn=_cmd_flow)

    # coil — coiled-spring (pre-breakout accumulation)
    s = sub.add_parser("coil", help="Coiled-spring setups: volume rising + price range-bound + warrant flow accelerating vs common.")
    s.add_argument("--pairs", default="warrants_universe.csv")
    s.add_argument("--period", default="3mo")
    s.add_argument("--min-dvol", type=float, default=1000.0)
    s.add_argument("--max-range", type=float, default=0.20,
                  help="Max 10-day price (high-low)/mean to count as range-bound.")
    s.add_argument("--min-accel", type=float, default=1.5,
                  help="Min vol_w0/vol_w2 ratio (volume ramp across 5d vs 10-30d).")
    s.add_argument("--sort", default="coil_score",
                  choices=["coil_score", "vol_accel", "w2c_accel",
                           "range_pct_10d", "dvol_5d"])
    s.add_argument("--top", type=int, default=25)
    s.add_argument("--out", default=None)
    s.set_defaults(fn=_cmd_coil)

    # conviction — cross-screen merge
    s = sub.add_parser("conviction",
        help="Cross-merge fair value + flow + coil into one confirmed rank.")
    s.add_argument("--pairs", default="warrants_universe.csv")
    s.add_argument("--period", default="1y")
    s.add_argument("--resolve-edgar", action="store_true")
    s.add_argument("--no-shells", action="store_true",
                  help="Drop pre-deal SPAC shells from output.")
    s.add_argument("--top", type=int, default=20)
    s.add_argument("--out", default=None)
    s.set_defaults(fn=_cmd_conviction)

    # edgar
    s = sub.add_parser("edgar", help="Recent EDGAR filings for a ticker.")
    s.add_argument("ticker")
    s.add_argument("--forms", default="8-K,S-1,S-3,424B5",
                  help="Comma-separated form types.")
    s.add_argument("--limit", type=int, default=15)
    s.add_argument("--search", action="store_true",
                  help="Also print an EDGAR full-text-search URL.")
    s.set_defaults(fn=_cmd_edgar)

    args = p.parse_args()
    rc = args.fn(args)
    sys.exit(rc or 0)


if __name__ == "__main__":
    cli()
