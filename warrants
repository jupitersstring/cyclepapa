                                       0.1, key="screen_min_z"))

    pairs: list[tuple[str, str]] = []
    pairs_df: pd.DataFrame | None = None

    if mode == "NASDAQ Trader (all listed warrants)":
        if st.button("Load listed warrants", key="nasdaq_btn"):
            try:
                with st.spinner("Fetching listed-warrant universe..."):
                    pairs_df = extract_warrant_pairs()
                st.write(f"Universe size: {len(pairs_df)} listed warrant pairs.")
                st.session_state["screen_pairs_df"] = pairs_df
            except Exception as e:
                st.error(f"Universe step failed: {e}")
        pairs_df = st.session_state.get("screen_pairs_df")

    elif mode == "financedatabase (small/micro cap US)":
        if st.button("Discover warrants", key="discover_btn"):
            try:
                with st.spinner("Loading universe..."):
                    uni = load_smallcap_universe()
                st.write(f"Universe size: {len(uni)} — probing first "
                         f"{limit}.")
                prog = st.progress(0.0)
                status = st.empty()

                def _cb(p, c, w):
                    prog.progress(p)
                    status.write(f"{c} → {w or 'no warrant found'}")

                pairs_df = discover_warrants_for(
                    uni["common"].dropna().astype(str).tolist(),
                    limit=limit, progress_cb=_cb,
                )
                pairs_df = pairs_df.dropna(subset=["warrant"])
                st.session_state["screen_pairs_df"] = pairs_df
                status.write(f"Found {len(pairs_df)} pairs with warrant data.")
            except Exception as e:
                st.error(f"Universe step failed: {e}")
        pairs_df = st.session_state.get("screen_pairs_df")

    elif mode == "Paste commons":
        raw = st.text_area(
            "Common tickers (one per line or comma-separated)",
            value="GME\nLCID\nBARK\nASTS\nDNA",
            key="screen_commons",
        )
        commons = [t.strip().upper() for t in raw.replace(",", "\n").splitlines()
                   if t.strip()]
        if st.button("Discover warrants", key="discover_commons_btn"):
            prog = st.progress(0.0)
            status = st.empty()

            def _cb(p, c, w):
                prog.progress(p)
                status.write(f"{c} → {w or 'no warrant found'}")

            pairs_df = discover_warrants_for(commons, limit=limit,
                                             progress_cb=_cb)
            pairs_df = pairs_df.dropna(subset=["warrant"])
            st.session_state["screen_pairs_df"] = pairs_df
        pairs_df = st.session_state.get("screen_pairs_df")

    elif mode == "Paste pairs":
        raw = st.text_area(
            "Pairs as common,warrant (one per line)",
            value="GME,GME-WT\nLCID,LCIDW\nBARK,BARK-WS",
            key="screen_pairs_text",
        )
        rows = []
        for line in raw.splitlines():
            parts = [p.strip() for p in line.split(",")]
            if len(parts) >= 2 and parts[0] and parts[1]:
                rows.append({"common": parts[0].upper(),
                             "warrant": parts[1].upper()})
        pairs_df = pd.DataFrame(rows) if rows else None

    elif mode == "Upload pair CSV":
        upl = st.file_uploader("CSV with columns: common,warrant", type="csv",
                               key="screen_csv")
        if upl is not None:
            pairs_df = pd.read_csv(upl)
            pairs_df.columns = [c.lower() for c in pairs_df.columns]
            pairs_df = pairs_df[["common", "warrant"]].dropna()

    if pairs_df is None or pairs_df.empty:
        st.info("Pick a universe source and load pairs to begin.")
        return

    st.dataframe(pairs_df, use_container_width=True, height=200)

    if st.button("Run batch scan", type="primary", key="run_batch"):
        pairs = [(r["common"], r["warrant"]) for _, r in pairs_df.iterrows()]
        with st.spinner(f"Scanning {len(pairs)} pairs..."):
            summary, details = batch_scan(
                pairs, period=period,
                lookbacks={"Weekly": lookback_w, "Monthly": lookback_m},
                prominence=prominence,
            )
        st.session_state["screen_summary"] = summary
        st.session_state["screen_details"] = details

    summary = st.session_state.get("screen_summary")
    details = st.session_state.get("screen_details", {})
    if summary is None or summary.empty:
        return

    ranked = rank_dislocations(summary, by=rank_by)
    if min_abs_z > 0 and "abs_z" in ranked.columns:
        ranked = ranked[ranked["abs_z"] >= min_abs_z]
    st.subheader(f"Top dislocations by {rank_by} ({len(ranked)})")
    st.dataframe(ranked, use_container_width=True)

    st.subheader("All TF rows")
    st.dataframe(summary, use_container_width=True)

    pick = st.selectbox("Drill into a pair", [""] + list(details.keys()),
                        format_func=lambda x: f"{x[1]}/{x[0]}" if x else "")
    if pick:
        for tf, payload in details[pick].items():
            st.markdown(f"### {pick[1]}/{pick[0]} — {tf}")
            st.plotly_chart(_plot(payload["signals"],
                                  payload["inflections"], tf),
                            use_container_width=True)


def _parity_tab():
    st.subheader("Option vs. warrant parity (model-free arb check)")
    st.caption("Compare a warrant's market price to the listed call at "
               "the same strike & expiry. Theoretical: "
               "`warrant ≈ ratio × dilution × call_mid`.")

    c1, c2, c3, c4 = st.columns(4)
    common = c1.text_input("Common ticker", value="GME", key="par_common")
    warrant_ticker = c2.text_input("Warrant ticker (optional, for live px)",
                                   value="GME WT", key="par_warrant")
    strike = float(c3.number_input("Warrant strike", value=32.0, step=0.5,
                                    key="par_strike"))
    expiry = c4.text_input("Warrant expiry (YYYY-MM-DD)", value="2032-06-15",
                           key="par_expiry")

    c5, c6, c7 = st.columns(3)
    warrant_ratio = float(c5.number_input("Shares per warrant", value=1.0,
                                          step=0.1, key="par_ratio"))
    dilution = float(c6.number_input("Dilution factor", value=1.0, step=0.01,
                                     min_value=0.0, max_value=1.0,
                                     key="par_dilution"))
    warrant_px_override = c7.number_input(
        "Warrant price (override, 0 = auto)", value=0.0, step=0.01,
        key="par_px",
    )

    if st.button("Check parity", type="primary", key="par_run"):
        warrant_px = float(warrant_px_override)
        if warrant_px <= 0 and warrant_ticker:
            px = _fetch_last_close(warrant_ticker, sentinel_ticker=common)
            if px is None:
                st.warning(
                    f"Could not fetch a distinct price for {warrant_ticker}. "
                    "Yahoo may not carry this warrant under that ticker. "
                    "Enter the warrant price manually in the override field."
                )
            else:
                warrant_px = px
        if warrant_px <= 0:
            st.error("Provide a warrant price (override or valid ticker).")
            return
        try:
            res = option_warrant_parity(
                common_ticker=common, warrant_price=warrant_px,
                strike=strike, expiry=expiry,
                warrant_ratio=warrant_ratio, dilution_factor=dilution,
            )
        except Exception as e:
            st.error(f"Parity check failed: {e}")
            return
        if "error" in res:
            st.error(res["error"])
            return
        gap_pct = res["gap_pct"]
        if gap_pct < -0.05:
            st.error(f"**{res['verdict']}** — gap {gap_pct:.1%}")
        elif gap_pct > 0.05:
            st.warning(f"**{res['verdict']}** — gap {gap_pct:.1%}")
        else:
            st.success(f"**{res['verdict']}** — gap {gap_pct:.1%}")
        st.json(res)


