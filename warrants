"""Warrant mispricing scanner.

Library of pure functions plus an argparse CLI. Run with:

    python warrants universe                       # build & save universe
    python warrants pair LCID LCIDW                # technical scan on one pair
    python warrants screen [--quality]             # BS fair-value screen
    python warrants parity GME "GME WT" 32 2032-06-15
    python warrants edgar GME

Signals per timeframe (Weekly, Monthly):
  - ratio_z:    rolling z of log(warrant / common)
  - resid_z:    rolling z of the residual from rolling OLS
                log(warrant) ~ a + b * log(common)
  - composite_z: average of the two
  - joint_z:    composite_z amplified by confirming volume
Inflections on joint_z: local peaks/troughs and zero-crossings.
"""
from __future__ import annotations

import argparse
import logging
import re
import sys
from urllib.parse import quote_plus

