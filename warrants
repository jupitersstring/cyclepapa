def _fair_value_tab():
    st.subheader("Black-Scholes fair-value scan — discounts that don't make sense")
    st.caption("For each pair, model the warrant as a call on the common using "
               "realized vol; flag warrants priced far below BS fair value where "
               "the discount can't be explained by redemption-cap risk.")

    c1, c2, c3, c4 = st.columns(4)
    strike = float(c1.number_input("Assumed strike ($)", 1.0, 100.0, 11.50, 0.5,
                                   key="fv_strike"))
    T_years = float(c2.number_input("Assumed T (years)", 0.25, 10.0, 3.0, 0.25,
                                    key="fv_T"))
    r = float(c3.number_input("Risk-free r", 0.0, 0.15, 0.045, 0.005,
                              key="fv_r"))
    dilution = float(c4.number_input("Dilution factor", 0.5, 1.0, 0.90, 0.01,
                                     key="fv_dilution"))

    c5, c6, c7 = st.columns(3)
    max_money = float(c5.number_input("Max moneyness (OTM filter)", 0.1, 2.0,
                                      0.85, 0.05, key="fv_money"))
    max_gap = float(c6.number_input("Max gap_pct (e.g. -0.70 = -70%)",
                                    -1.0, 0.0, -0.70, 0.05, key="fv_gap"))
    period = c7.selectbox("Vol history window", ["6mo", "1y", "2y"],
                         index=1, key="fv_period")

    source = st.radio("Universe", ["Current screener pairs",
                                   "NASDAQ Trader (all listed warrants)",
                                   "Upload pair CSV"],
                     horizontal=True, key="fv_source")

    pairs_df = None
    if source == "Current screener pairs":
        pairs_df = st.session_state.get("screen_pairs_df")
        if pairs_df is None or pairs_df.empty:
            st.info("Load pairs in the Screener tab first.")
            return
    elif source == "NASDAQ Trader (all listed warrants)":
        if st.button("Load universe & scan", key="fv_load_btn"):
            with st.spinner("Loading universe..."):
                pairs_df = extract_warrant_pairs()
            st.session_state["fv_pairs_df"] = pairs_df
        pairs_df = st.session_state.get("fv_pairs_df")
    else:
        upl = st.file_uploader("CSV with common,warrant", type="csv",
                              key="fv_csv")
        if upl is not None:
            pairs_df = pd.read_csv(upl)
            pairs_df.columns = [c.lower() for c in pairs_df.columns]

    if pairs_df is None or pairs_df.empty:
        return

    if st.button("Run fair-value scan", type="primary", key="fv_run"):
        with st.spinner(f"Pricing {len(pairs_df)} pairs (BS, 1y realized vol)..."):
            fair = fair_value_scan(pairs_df, period=period, strike=strike,
                                    T_years=T_years, r=r, dilution=dilution)
        st.session_state["fv_result"] = fair

    fair = st.session_state.get("fv_result")
    if fair is None or fair.empty:
        return

    real = filter_real_arbs(fair, max_moneyness=max_money,
                            max_gap_pct=max_gap)
    st.subheader(f"Discounts no longer making sense — {len(real)} pairs")
    st.caption("OTM, no recent ≥$18 print (no redemption-cap pressure), "
               "sigma 0.40–1.50, theoretical ≥ $0.50, gap ≤ threshold.")
    show_cols = ["common", "warrant", "common_px", "warrant_px", "moneyness",
                 "sigma_used", "bs_call", "theoretical", "gap_pct",
                 "security_name"]
    st.dataframe(real[show_cols], use_container_width=True)

    with st.expander(f"Full scan ({len(fair)} pairs) — includes "
                     "redemption-risk and high-vol names"):
        all_cols = show_cols + ["days_above_18", "sigma_1y", "sigma_3m",
                                "redemption_risk"]
        st.dataframe(fair[[c for c in all_cols if c in fair.columns]],
                    use_container_width=True)

    st.markdown("---")
    st.subheader("Composite rank: discount × biz quality × positive inflection")
    st.caption("Layer fundamental scoring on top of deep-discount survivors. "
               "Pulls yfinance.info per common — slow on first run.")
    c_q1, c_q2, c_q3 = st.columns(3)
    gap_th = float(c_q1.number_input("Gap threshold for shortlist", -1.0, 0.0,
                                      -0.50, 0.05, key="ql_gap"))
    money_cap = float(c_q2.number_input("Max moneyness", 0.1, 2.0, 0.90, 0.05,
                                         key="ql_money"))
    top_n = int(c_q3.number_input("Max names to score", 5, 200, 60,
                                    key="ql_topn"))
    if st.button("Score quality + inflection", type="primary", key="ql_run"):
        with st.spinner("Pulling fundamentals from yfinance..."):
            ranked = rank_discount_quality_inflection(
                fair, gap_threshold=gap_th, max_moneyness=money_cap,
                top_n_to_score=top_n,
            )
        st.session_state["ql_ranked"] = ranked
    ranked = st.session_state.get("ql_ranked")
    if ranked is not None and not ranked.empty:
        rank_cols = ["common", "warrant", "warrant_px", "common_px",
                     "moneyness", "gap_pct", "totalRevenue", "revenueGrowth",
                     "grossMargins", "earningsQuarterlyGrowth",
                     "rev_score", "margin_score", "runway_score",
                     "quality", "inflection", "composite", "security_name"]
        rank_cols = [c for c in rank_cols if c in ranked.columns]
        st.dataframe(ranked[rank_cols], use_container_width=True)


