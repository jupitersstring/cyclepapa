"""Warrant mispricing scanner.

Finds relative-value dislocations (extreme z-scores) and inflections
(turns / zero-crossings) of a warrant vs. its underlying common on
weekly and monthly timeframes.

Signals per timeframe:
  - ratio_z:    rolling z of log(warrant / common)
  - resid_z:    rolling z of the residual from rolling OLS
                log(warrant) ~ a + b * log(common)   (cointegration spread)
  - composite_z: average of the two
Inflections on composite_z: local peaks/troughs (find_peaks) and
zero-crossings.

Run as a Streamlit app:   cp warrants warrants_app.py && streamlit run warrants_app.py
(streamlit requires a .py extension; warrants_app.py is gitignored)
Or import as a module to reuse the pure functions.
"""
from __future__ import annotations

import re
from urllib.parse import quote_plus

import numpy as np
import pandas as pd
import requests
import yfinance as yf
import streamlit as st
import plotly.graph_objects as go
from plotly.subplots import make_subplots
from scipy.signal import find_peaks


TIMEFRAMES = {"Weekly": "W-FRI", "Monthly": "ME"}
DEFAULT_LOOKBACK = {"Weekly": 26, "Monthly": 24}

# Common ticker conventions for U.S. warrants across Yahoo Finance.
# Space-prefixed variants (e.g. "GME WT") are how Yahoo carries some NYSE warrants.
WARRANT_SUFFIXES = [".WS", "-WT", ".WT", "W", "WS", "WT", "-WS",
                    ".WTA", ".WTB", ".U", " WT", " WS"]

EDGAR_HEADERS = {"User-Agent": "warrant-scanner research@cyclepapa.local"}


# ---------- pure signal functions ----------

def resample_pair(df: pd.DataFrame, freq: str) -> pd.DataFrame:
    """Resample to period bars. Closes use last(); *_vol columns sum()."""
    agg = {c: ("sum" if c.endswith("_vol") else "last") for c in df.columns}
    price_cols = [c for c in df.columns if not c.endswith("_vol")]
    return df.resample(freq).agg(agg).dropna(subset=price_cols)


def rolling_zscore(s: pd.Series, lookback: int) -> pd.Series:
    mean = s.rolling(lookback).mean()
    std = s.rolling(lookback).std()
    return (s - mean) / std


def rolling_ols_residual(y: pd.Series, x: pd.Series, lookback: int):
    """Rolling OLS  y ~ alpha + beta * x.  Returns (alpha, beta, residual)."""
    cov = x.rolling(lookback).cov(y)
    var = x.rolling(lookback).var()
    beta = cov / var
    alpha = y.rolling(lookback).mean() - beta * x.rolling(lookback).mean()
    fitted = alpha + beta * x
    resid = y - fitted
    return alpha, beta, resid


def compute_signals(pair_df: pd.DataFrame, lookback: int) -> pd.DataFrame:
    """Build the signal frame for one timeframe."""
    common = pair_df["common"].astype(float)
    warrant = pair_df["warrant"].astype(float)
    log_common = np.log(common)
    log_warrant = np.log(warrant)
    log_ratio = log_warrant - log_common

    out = pd.DataFrame(index=pair_df.index)
    out["common"] = common
    out["warrant"] = warrant
    out["ratio"] = warrant / common
    out["log_ratio"] = log_ratio
    out["ratio_z"] = rolling_zscore(log_ratio, lookback)

    alpha, beta, resid = rolling_ols_residual(log_warrant, log_common, lookback)
    out["alpha"] = alpha
    out["beta"] = beta
    out["resid"] = resid
    out["resid_z"] = rolling_zscore(resid, lookback)

    out["composite_z"] = (out["ratio_z"] + out["resid_z"]) / 2
    return out


def detect_inflections(z: pd.Series, prominence: float = 0.5) -> pd.DataFrame:
    """Local peaks/troughs and sign changes of a z-score series."""
    z = z.dropna()
    if z.empty:
        return pd.DataFrame(columns=["date", "kind", "z"])
    arr = z.to_numpy()
    peaks, _ = find_peaks(arr, prominence=prominence)
    troughs, _ = find_peaks(-arr, prominence=prominence)
    sign = np.sign(arr)
    crosses = np.where(np.diff(sign) != 0)[0] + 1

    rows = []
    for i in peaks:
        rows.append({"date": z.index[i], "kind": "peak", "z": float(arr[i])})
    for i in troughs:
        rows.append({"date": z.index[i], "kind": "trough", "z": float(arr[i])})
    for i in crosses:
        rows.append({"date": z.index[i], "kind": "zero_cross", "z": float(arr[i])})
    if not rows:
        return pd.DataFrame(columns=["date", "kind", "z"])
    return pd.DataFrame(rows).sort_values("date").reset_index(drop=True)


def compute_volume_signals(df: pd.DataFrame, lookback: int) -> pd.DataFrame:
    """Volume z-scores. Requires *_vol columns from yfinance Volume."""
    out = pd.DataFrame(index=df.index)
    if "warrant_vol" in df.columns and "warrant" in df.columns:
        wvol = df["warrant_vol"].astype(float).replace(0, np.nan)
        out["warrant_vol"] = wvol
        out["warrant_vol_z"] = rolling_zscore(np.log(wvol), lookback)
        out["warrant_relvol"] = wvol / wvol.rolling(lookback).median()
        dollar = wvol * df["warrant"]
        out["warrant_dollar_vol"] = dollar
        out["warrant_dollar_vol_z"] = rolling_zscore(
            np.log(dollar.replace(0, np.nan)), lookback)
    if "common_vol" in df.columns:
        cvol = df["common_vol"].astype(float).replace(0, np.nan)
        out["common_vol"] = cvol
        out["common_vol_z"] = rolling_zscore(np.log(cvol), lookback)
        if "warrant_vol" in df.columns:
            ratio = (df["warrant_vol"].replace(0, np.nan) / cvol)
            out["w2c_vol"] = ratio
            out["w2c_vol_z"] = rolling_zscore(np.log(ratio), lookback)
    return out


def detect_volume_anomalies(sig: pd.DataFrame, threshold: float = 2.0,
                            lookback: int = 12) -> pd.DataFrame:
    """Bars where any volume z-score breaches threshold (absolute)."""
    cols = [c for c in ("warrant_vol_z", "warrant_dollar_vol_z", "w2c_vol_z")
            if c in sig.columns]
    rows = []
    for c in cols:
        s = sig[c].dropna()
        for d, v in s[s.abs() >= threshold].items():
            rows.append({"date": d, "metric": c, "z": float(v)})
    if not rows:
        return pd.DataFrame(columns=["date", "metric", "z"])
    return pd.DataFrame(rows).sort_values(["date", "metric"]).reset_index(drop=True)


def _joint_z(price_z: pd.Series, vol_z: pd.Series, vol_weight: float = 0.5) -> pd.Series:
    """price dislocation amplified by *confirming* volume.

    joint = price_z + vol_weight * max(vol_z, 0) * sign(price_z)

    Idea: a price dislocation is much more actionable when accompanied
    by an unusual volume print — volume confirms the move. Quiet
    dislocations get the original price_z; loud dislocations get bigger.
    """
    if vol_z is None or vol_z.isna().all():
        return price_z
    confirm = vol_z.fillna(0).clip(lower=0)
    return price_z + vol_weight * np.sign(price_z) * confirm


def scan_pair(pair_df: pd.DataFrame, lookbacks: dict | None = None,
              prominence: float = 0.5, vol_weight: float = 0.5) -> dict:
    """Run the scan across all timeframes.

    Returns {tf: {signals, inflections, vol_anomalies}}. signals includes
    price z-scores, volume z-scores (if Volume present), and joint_z.
    """
    lookbacks = lookbacks or DEFAULT_LOOKBACK
    out = {}
    for tf_name, freq in TIMEFRAMES.items():
        resampled = resample_pair(pair_df, freq)
        if len(resampled) < lookbacks[tf_name] + 2:
            continue
        price_sig = compute_signals(resampled, lookbacks[tf_name])
        vol_sig = compute_volume_signals(resampled, lookbacks[tf_name])
        merged = pd.concat([price_sig, vol_sig], axis=1)
        vz = merged["w2c_vol_z"] if "w2c_vol_z" in merged.columns \
            else merged.get("warrant_vol_z")
        merged["joint_z"] = _joint_z(merged["composite_z"], vz,
                                     vol_weight=vol_weight)
        infl = detect_inflections(merged["joint_z"], prominence=prominence)
        vol_anom = detect_volume_anomalies(merged, threshold=2.0)
        out[tf_name] = {"signals": merged, "inflections": infl,
                        "vol_anomalies": vol_anom}
    return out


def summarize(scan: dict) -> pd.DataFrame:
    """Latest reading per timeframe."""
    rows = []

    def _g(last, key, ndigits=2):
        v = last.get(key, np.nan) if hasattr(last, "get") else np.nan
        try:
            v = float(v)
        except Exception:
            return None
        if np.isnan(v):
            return None
        return round(v, ndigits)

    for tf, payload in scan.items():
        sig = payload["signals"].dropna(subset=["composite_z"])
        if sig.empty:
            continue
        last = sig.iloc[-1]
        infl = payload["inflections"]
        last_infl = infl.iloc[-1] if not infl.empty else None
        vol_anom = payload.get("vol_anomalies", pd.DataFrame())
        last_vol = vol_anom.iloc[-1] if not vol_anom.empty else None
        z = float(last["composite_z"])
        jz = float(last.get("joint_z", z)) if not pd.isna(last.get("joint_z", z)) else z
        regime = "rich" if jz > 1 else ("cheap" if jz < -1 else "neutral")
        rows.append({
            "timeframe": tf,
            "as_of": sig.index[-1].date(),
            "ratio_z": _g(last, "ratio_z"),
            "resid_z": _g(last, "resid_z"),
            "composite_z": round(z, 2),
            "warrant_vol_z": _g(last, "warrant_vol_z"),
            "w2c_vol_z": _g(last, "w2c_vol_z"),
            "warrant_relvol": _g(last, "warrant_relvol"),
            "joint_z": round(jz, 2),
            "beta": _g(last, "beta", 3),
            "regime": regime,
            "last_inflection": last_infl["date"].date() if last_infl is not None else None,
            "last_inflection_kind": last_infl["kind"] if last_infl is not None else None,
            "last_vol_anom": last_vol["date"].date() if last_vol is not None else None,
        })
    return pd.DataFrame(rows)


# ---------- data loading ----------

def load_pair_yf(common_ticker: str, warrant_ticker: str,
                 period: str = "5y") -> pd.DataFrame:
    """Pull daily Close + Volume for both legs from Yahoo and align.

    Returns columns: common, warrant, common_vol, warrant_vol.
    """
    data = yf.download(
        [common_ticker, warrant_ticker],
        period=period,
        auto_adjust=True,
        progress=False,
        group_by="column",
    )
    if isinstance(data.columns, pd.MultiIndex):
        close = data["Close"]
        vol = data["Volume"] if "Volume" in data.columns.get_level_values(0) \
            else pd.DataFrame(index=close.index)
    else:
        close = data[["Close"]].copy(); close.columns = [common_ticker]
        vol = data[["Volume"]].copy() if "Volume" in data.columns \
            else pd.DataFrame(index=close.index)
        if not vol.empty:
            vol.columns = [common_ticker]
    out = pd.DataFrame({
        "common": close.get(common_ticker),
        "warrant": close.get(warrant_ticker),
        "common_vol": vol.get(common_ticker),
        "warrant_vol": vol.get(warrant_ticker),
    }).dropna(subset=["common", "warrant"])
    return out


# ---------- universe (financedatabase) ----------

@st.cache_data(ttl=24 * 3600, show_spinner=False)
def load_smallcap_universe(country: str = "United States",
                           market_caps=("Small Cap", "Micro Cap")) -> pd.DataFrame:
    """Approximate Russell 2000 via financedatabase small/micro caps."""
    try:
        import financedatabase as fd
    except ImportError as e:
        raise RuntimeError(
            "financedatabase not installed — run `pip install financedatabase`"
        ) from e
    eq = fd.Equities()
    df = eq.select(country=country, market_cap=list(market_caps))
    df = df.dropna(subset=["name"]).reset_index()
    sym_col = "symbol" if "symbol" in df.columns else df.columns[0]
    df = df.rename(columns={sym_col: "common"})
    keep = [c for c in ["common", "name", "sector", "industry", "market_cap", "exchange"]
            if c in df.columns]
    return df[keep]


_TSX_BOARDS = ("tsx", "tsxv")
TSX_COMMON_SUFFIX = {"TSX": ".TO", "TSXV": ".V"}
TSX_WARRANT_SUFFIXES = (".WT.TO", ".WS.TO", ".WTA.TO", ".UN.TO",
                        ".WT.V", ".WS.V", ".WTA.V")


@st.cache_data(ttl=24 * 3600, show_spinner=False)
def fetch_tsx_companies() -> pd.DataFrame:
    """All TSX + TSXV listed companies (alphabetic crawl of the public directory)."""
    rows = []
    for board in _TSX_BOARDS:
        for letter in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
            try:
                r = requests.get(
                    f"https://www.tsx.com/json/company-directory/search/"
                    f"{board}/{letter}",
                    headers=EDGAR_HEADERS, timeout=15,
                )
                if not r.ok:
                    continue
                for row in r.json().get("results", []):
                    sym = row.get("symbol")
                    name = row.get("name")
                    if sym:
                        rows.append({"symbol": sym, "name": name,
                                     "board": board.upper()})
            except Exception:
                continue
    return (pd.DataFrame(rows).dropna(subset=["symbol"])
            .drop_duplicates(subset=["symbol", "board"])
            .reset_index(drop=True))


def discover_tsx_warrants(companies: pd.DataFrame | None = None,
                           chunk_size: int = 250,
                           min_bars: int = 30,
                           max_stale_days: int = 45) -> pd.DataFrame:
    """Batch-probe Yahoo for TSX/TSXV warrant tickers.

    Generates `<symbol><suffix>` candidates for each company, downloads
    them in chunks via the batch endpoint, and keeps the ones with
    recent data. Much faster than per-ticker probing.
    """
    if companies is None:
        companies = fetch_tsx_companies()
    if companies.empty:
        return pd.DataFrame(columns=["common", "warrant", "name", "exchange"])
    candidates = []
    for _, row in companies.iterrows():
        for sfx in TSX_WARRANT_SUFFIXES:
            board = row["board"]
            if (sfx.endswith(".TO") and board == "TSX") or \
               (sfx.endswith(".V") and board == "TSXV"):
                candidates.append((f"{row['symbol']}{sfx}", row))
    out = []
    cutoff = pd.Timestamp.utcnow().tz_localize(None) - \
        pd.Timedelta(days=max_stale_days)
    for i in range(0, len(candidates), chunk_size):
        batch = candidates[i:i + chunk_size]
        bundle = batch_load_pairs([c[0] for c in batch], period="6mo")
        closes = bundle["close"]
        if closes.empty:
            continue
        for ticker, row in batch:
            if ticker not in closes.columns:
                continue
            s = closes[ticker].dropna()
            if len(s) < min_bars:
                continue
            last = s.index[-1].tz_localize(None) if s.index.tz is not None \
                else s.index[-1]
            if last < cutoff:
                continue
            board = row["board"]
            common_y = f"{row['symbol']}{TSX_COMMON_SUFFIX[board]}"
            out.append({"common": common_y, "warrant": ticker,
                        "name": row["name"], "exchange": board})
    return pd.DataFrame(out).drop_duplicates(subset=["warrant"]) \
                            .reset_index(drop=True)


# ---------- universe (NASDAQ Trader daily listings) ----------

NASDAQ_LISTED_URL = "https://www.nasdaqtrader.com/dynamic/SymDir/nasdaqlisted.txt"
OTHER_LISTED_URL = "https://www.nasdaqtrader.com/dynamic/SymDir/otherlisted.txt"


@st.cache_data(ttl=24 * 3600, show_spinner=False)
def fetch_nasdaqtrader_listings() -> pd.DataFrame:
    """All U.S. exchange-listed securities (NASDAQ + NYSE/AMEX/ARCA)."""
    import io as _io

    def _load(url):
        r = requests.get(url, headers=EDGAR_HEADERS, timeout=30)
        r.raise_for_status()
        df = pd.read_csv(_io.StringIO(r.text), sep="|")
        if not df.empty:
            df = df[~df.iloc[:, 0].astype(str).str.startswith("File Creation Time",
                                                              na=False)]
        return df

    nas = _load(NASDAQ_LISTED_URL).rename(
        columns={"Symbol": "symbol", "Security Name": "security_name"})
    nas["exchange"] = "NASDAQ"
    other = _load(OTHER_LISTED_URL).rename(
        columns={"ACT Symbol": "symbol", "Security Name": "security_name",
                 "Exchange": "exchange"})
    cols = ["symbol", "security_name", "exchange"]
    return pd.concat([nas[cols], other[cols]], ignore_index=True) \
             .dropna(subset=cols)


WARRANT_NAME_RE = r"\bWARRANTS?\b|\bWT[S]?\b"
NON_COMMON_RE = (r"\bDEPOSITARY\b|\bPREFERRED\b|\bUNIT[S]?\b|\bRIGHT[S]?\b|"
                 r"\bNOTE[S]?\b|\bBOND[S]?\b|\bDEBENTURE\b|\bTRUST\b|"
                 r"\bCONVERTIBLE\b|\bSUBORDINATED\b|\bSERIES\b")


_ISSUER_SUFFIX_RE = re.compile(
    r"\b(CORPORATION|CORP|INC(?:ORPORATED)?|LTD|LIMITED|LLC|PLC|"
    r"HOLDINGS?|GROUP|COMPANY|CO|TRUST|N\.V\.|S\.A\.|S\.A|N\.V|AG|SE)\.?\b"
)
_ISSUER_CLASS_RE = re.compile(
    r"\b(CLASS\s+[A-D]|CL\s+[A-D]|COMMON\s+(STOCK|SHARES?)|"
    r"ORDINARY\s+SHARES?|SHARES?)\b"
)
_WARRANT_SPLIT_RE = re.compile(r"\b(WARRANTS?|WT[S]?)\b")


def _issuer_key(name: str) -> str:
    """Normalize an issuer label so common+warrant rows match by issuer."""
    s = str(name).upper()
    s = _WARRANT_SPLIT_RE.split(s, maxsplit=1)[0]
    s = _ISSUER_SUFFIX_RE.sub("", s)
    s = _ISSUER_CLASS_RE.sub("", s)
    s = re.sub(r"[-,]+", " ", s)
    return re.sub(r"\s+", " ", s).strip(" .-")


def _to_yahoo_ticker(symbol: str) -> str:
    """NASDAQ Trader uses dot-suffixes (e.g. GME.W); Yahoo uses dashes."""
    return str(symbol).replace(".", "-").strip()


@st.cache_data(ttl=24 * 3600, show_spinner=False)
def extract_warrant_pairs(min_share_price: float = 0.0) -> pd.DataFrame:
    """All warrant tickers from U.S. exchange listings paired with their common.

    Returns columns: common, warrant, issuer_key, security_name, exchange.
    No freshness check — caller must validate via Yahoo.
    """
    listings = fetch_nasdaqtrader_listings()
    df = listings.copy()
    df["name_upper"] = df["security_name"].astype(str).str.upper()
    warrant_mask = df["name_upper"].str.contains(WARRANT_NAME_RE, regex=True,
                                                 na=False)
    non_common = df["name_upper"].str.contains(NON_COMMON_RE, regex=True,
                                               na=False)
    common_mask = ~warrant_mask & ~non_common
    warrants = df[warrant_mask].copy()
    commons = df[common_mask].copy()
    warrants["issuer_key"] = warrants["security_name"].apply(_issuer_key)
    commons["issuer_key"] = commons["security_name"].apply(_issuer_key)
    common_by_key = (commons.drop_duplicates(subset="issuer_key")
                            .set_index("issuer_key")["symbol"])
    warrants["common"] = warrants["issuer_key"].map(common_by_key)
    paired = warrants.dropna(subset=["common"]).copy()
    paired = paired.rename(columns={"symbol": "warrant"})
    paired["common"] = paired["common"].map(_to_yahoo_ticker)
    paired["warrant"] = paired["warrant"].map(_to_yahoo_ticker)
    return paired[["common", "warrant", "issuer_key",
                   "security_name", "exchange"]].reset_index(drop=True)


def filter_active_pairs(pairs_df: pd.DataFrame, period: str = "1y",
                        max_stale_days: int = 30) -> pd.DataFrame:
    """Keep only pairs where both legs traded within max_stale_days.

    One batch yfinance call validates the whole list — far faster than
    per-ticker probing.
    """
    if pairs_df.empty:
        return pairs_df
    tickers = sorted(set(pairs_df["common"]) | set(pairs_df["warrant"]))
    bundle = batch_load_pairs(tickers, period=period)
    closes = bundle["close"]
    if closes.empty:
        return pairs_df.iloc[0:0]
    cutoff = pd.Timestamp.utcnow().tz_localize(None) - pd.Timedelta(days=max_stale_days)

    def _last(s):
        s = s.dropna()
        return s.index[-1].tz_localize(None) if len(s) else pd.NaT

    last_dates = closes.apply(_last)
    active = set(last_dates[last_dates >= cutoff].index)
    mask = pairs_df["common"].isin(active) & pairs_df["warrant"].isin(active)
    out = pairs_df[mask].copy()
    out["last_warrant_bar"] = out["warrant"].map(last_dates).dt.date
    return out.reset_index(drop=True)


# ---------- warrant discovery (yfinance suffix probing) ----------

@st.cache_data(ttl=7 * 24 * 3600, show_spinner=False)
def _yf_probe(ticker: str, min_bars: int = 60, max_stale_days: int = 30) -> bool:
    """True if ticker has enough bars AND traded within max_stale_days."""
    try:
        df = yf.download(ticker, period="6mo", progress=False,
                         auto_adjust=True, threads=False)
        if df is None or df.empty:
            return False
        if isinstance(df.columns, pd.MultiIndex):
            if "Close" in df.columns.get_level_values(0):
                df = df["Close"]
        clean = df.dropna(how="all")
        if len(clean) < min_bars:
            return False
        last_ts = clean.index[-1]
        age_days = (pd.Timestamp.utcnow().tz_localize(None) -
                    last_ts.tz_localize(None) if last_ts.tz is not None
                    else pd.Timestamp.utcnow().tz_localize(None) - last_ts).days
        return age_days <= max_stale_days
    except Exception:
        return False


def _yf_has_data(ticker: str, min_bars: int = 60) -> bool:
    """Legacy alias retained for backward compat (no staleness check)."""
    return _yf_probe(ticker, min_bars=min_bars, max_stale_days=10_000)


def discover_warrant(common: str, suffixes=WARRANT_SUFFIXES,
                     max_stale_days: int = 30) -> str | None:
    """Try suffix conventions; return first warrant ticker with *recent* data."""
    for suf in suffixes:
        candidate = f"{common}{suf}"
        if _yf_probe(candidate, max_stale_days=max_stale_days):
            return candidate
    return None


def discover_warrants_for(commons: list[str], limit: int | None = None,
                          progress_cb=None) -> pd.DataFrame:
    rows = []
    sl = commons[:limit] if limit else commons
    for i, c in enumerate(sl):
        w = discover_warrant(c)
        rows.append({"common": c, "warrant": w})
        if progress_cb:
            progress_cb((i + 1) / len(sl), c, w)
    return pd.DataFrame(rows)


# ---------- batch scan ----------

def batch_load_pairs(tickers: list[str], period: str = "5y") -> dict:
    """One yfinance call for many tickers; returns {'close': df, 'volume': df}."""
    tickers = sorted(set(tickers))
    data = yf.download(tickers, period=period, auto_adjust=True,
                       progress=False, group_by="column", threads=True)
    if data is None or data.empty:
        return {"close": pd.DataFrame(), "volume": pd.DataFrame()}
    if isinstance(data.columns, pd.MultiIndex):
        levels = data.columns.get_level_values(0)
        close = data["Close"] if "Close" in levels else pd.DataFrame()
        volume = data["Volume"] if "Volume" in levels else pd.DataFrame()
    else:
        close = data[["Close"]].copy() if "Close" in data.columns else pd.DataFrame()
        if not close.empty:
            close.columns = tickers
        volume = data[["Volume"]].copy() if "Volume" in data.columns else pd.DataFrame()
        if not volume.empty:
            volume.columns = tickers
    return {"close": close, "volume": volume}


def batch_scan(pairs: list[tuple[str, str]], period: str = "5y",
               lookbacks: dict | None = None,
               prominence: float = 0.5,
               vol_weight: float = 0.5) -> tuple[pd.DataFrame, dict]:
    """Scan many (common, warrant) pairs. Returns (summary_df, details_dict)."""
    pairs = [(c, w) for c, w in pairs if c and w]
    if not pairs:
        return pd.DataFrame(), {}
    universe = [t for pair in pairs for t in pair]
    bundle = batch_load_pairs(universe, period=period)
    closes, vols = bundle["close"], bundle["volume"]
    summaries = []
    details = {}
    for common, warrant in pairs:
        if common not in closes.columns or warrant not in closes.columns:
            continue
        cols = {"common": closes[common], "warrant": closes[warrant]}
        if not vols.empty and common in vols.columns:
            cols["common_vol"] = vols[common]
        if not vols.empty and warrant in vols.columns:
            cols["warrant_vol"] = vols[warrant]
        df = pd.DataFrame(cols).dropna(subset=["common", "warrant"])
        if len(df) < 60:
            continue
        try:
            scan = scan_pair(df, lookbacks=lookbacks, prominence=prominence,
                             vol_weight=vol_weight)
        except Exception:
            continue
        if not scan:
            continue
        s = summarize(scan)
        if s.empty:
            continue
        s.insert(0, "pair", f"{warrant}/{common}")
        s.insert(1, "common", common)
        s.insert(2, "warrant", warrant)
        summaries.append(s)
        details[(common, warrant)] = scan
    summary = pd.concat(summaries, ignore_index=True) if summaries else pd.DataFrame()
    return summary, details


def rank_dislocations(summary: pd.DataFrame, by: str = "joint_z") -> pd.DataFrame:
    """One row per pair, max |z| across timeframes on the chosen metric."""
    if summary.empty or by not in summary.columns:
        by = "composite_z" if "composite_z" in summary.columns else None
    if by is None:
        return summary
    s = summary.dropna(subset=[by]).copy()
    s["abs_z"] = s[by].abs()
    idx = s.groupby("pair")["abs_z"].idxmax()
    return s.loc[idx].sort_values("abs_z", ascending=False).reset_index(drop=True)


