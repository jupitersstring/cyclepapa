# ---------- option vs. warrant parity (the GME case) ----------

def _fetch_last_close(ticker: str, sentinel_ticker: str | None = None) -> float | None:
    """Robust last close fetch via the batch endpoint.

    Single-ticker yf.download() fails on many warrant tickers
    (e.g. 'GRAB-W'); the batch endpoint handles them. If `sentinel_ticker`
    is given and the fetched series is identical to the sentinel's,
    return None — Yahoo sometimes falls back to a parent ticker for
    multi-word/missing warrants (e.g. 'GME WT' returns GME's prices).
    """
    try:
        tickers = [ticker, sentinel_ticker] if sentinel_ticker else [ticker]
        df = yf.download(tickers, period="10d", progress=False,
                         auto_adjust=True, group_by="column", threads=False)
        if df is None or df.empty:
            return None
        if isinstance(df.columns, pd.MultiIndex):
            close = df["Close"] if "Close" in df.columns.get_level_values(0) else None
            if close is None or ticker not in close.columns:
                return None
            s = close[ticker].dropna()
            if sentinel_ticker and sentinel_ticker in close.columns:
                ss = close[sentinel_ticker].dropna()
                if len(s) and len(ss) and len(s) == len(ss) and \
                        np.allclose(s.values, ss.values, rtol=1e-9):
                    return None
        else:
            s = df["Close"].dropna() if "Close" in df.columns else \
                df.iloc[:, 0].dropna()
        return float(s.iloc[-1]) if len(s) else None
    except Exception:
        return None


def option_warrant_parity(common_ticker: str, warrant_price: float,
                          strike: float, expiry: str,
                          warrant_ratio: float = 1.0,
                          dilution_factor: float = 1.0) -> dict:
    """Compare a warrant's market price to the listed call at the same
    strike & expiry. Theoretical fair value of one warrant:

        warrant ≈ warrant_ratio * dilution_factor * call_mid

    warrant_ratio  = shares delivered per warrant exercised (often 1.0,
                     sometimes 0.5 for SPAC-style 2:1 warrants)
    dilution_factor = N_shares / (N_shares + N_warrants_outstanding * ratio)
                      (1.0 if dilution is immaterial / already in float)
    """
    t = yf.Ticker(common_ticker)
    expiries = list(t.options or [])
    if not expiries:
        return {"error": f"no listed options for {common_ticker}"}
    target = pd.Timestamp(expiry)
    closest = min(expiries, key=lambda e: abs(pd.Timestamp(e) - target))
    chain = t.option_chain(closest).calls
    if chain is None or chain.empty:
        return {"error": f"empty call chain at {closest}"}
    row = chain.iloc[(chain["strike"] - strike).abs().argmin()]
    bid, ask, last = float(row["bid"]), float(row["ask"]), float(row["lastPrice"])
    call_mid = (bid + ask) / 2 if bid > 0 and ask > 0 else last
    theoretical = warrant_ratio * dilution_factor * call_mid
    gap = warrant_price - theoretical
    gap_pct = (gap / theoretical) if theoretical else float("nan")
    if gap_pct < -0.05:
        verdict = "WARRANT CHEAP vs. listed call (potential long warrant / short call)"
    elif gap_pct > 0.05:
        verdict = "WARRANT RICH vs. listed call (potential short warrant / long call)"
    else:
        verdict = "near parity"
    return {
        "common": common_ticker,
        "warrant_price": warrant_price,
        "target_strike": strike,
        "target_expiry": expiry,
        "matched_expiry": closest,
        "matched_strike": float(row["strike"]),
        "call_bid": bid,
        "call_ask": ask,
        "call_last": last,
        "call_mid": float(call_mid),
        "warrant_ratio": warrant_ratio,
        "dilution_factor": dilution_factor,
        "theoretical_warrant": float(theoretical),
        "gap": float(gap),
        "gap_pct": float(gap_pct),
        "verdict": verdict,
    }


# ---------- model-based fair value (Black-Scholes) ----------

from scipy.stats import norm as _norm


def bs_call(S: float, K: float, T: float, r: float, sigma: float) -> float:
    """Standard Black-Scholes European call. Intrinsic when T<=0 or sigma<=0."""
    if T <= 0 or sigma <= 0 or S <= 0 or K <= 0:
        return max(0.0, S - K)
    d1 = (np.log(S / K) + (r + 0.5 * sigma * sigma) * T) / (sigma * np.sqrt(T))
    d2 = d1 - sigma * np.sqrt(T)
    return float(S * _norm.cdf(d1) - K * np.exp(-r * T) * _norm.cdf(d2))


def fair_value_scan(pairs_df: pd.DataFrame, period: str = "1y",
                    strike: float = 11.50, T_years: float = 3.0,
                    r: float = 0.045, dilution: float = 0.90,
                    min_warrant_px: float = 0.05,
                    moneyness_cap: float = 0.85,
                    days_above_18_lookback: int = 60,
                    sigma_floor: float = 0.30,
                    sigma_cap: float = 2.00) -> pd.DataFrame:
    """For each (common, warrant) pair, compute the model-implied fair
    value and the gap to market. Filters out names where redemption-cap
    risk plausibly explains the discount.

    Returns a DataFrame sorted by gap_pct ascending (most-discounted
    first). Columns include moneyness, sigma_used, bs_call, theoretical,
    gap_pct, days_above_18.
    """
    if pairs_df.empty:
        return pd.DataFrame()
    tickers = sorted(set(pairs_df["common"]) | set(pairs_df["warrant"]))
    bundle = batch_load_pairs(tickers, period=period)
    closes = bundle["close"]
    if closes.empty:
        return pd.DataFrame()
    log_rets = np.log(closes / closes.shift(1))
    sigma_1y = log_rets.tail(252).std() * np.sqrt(252)
    sigma_3m = log_rets.tail(63).std() * np.sqrt(252)
    last_close = closes.ffill().iloc[-1]
    days_above_18 = closes.apply(
        lambda s: int((s.dropna().tail(days_above_18_lookback) >= 18).sum())
    )
    rows = []
    for _, r_ in pairs_df.iterrows():
        try:
            cpx = float(last_close[r_["common"]])
            wpx = float(last_close[r_["warrant"]])
        except Exception:
            continue
        if abs(cpx - wpx) < 1e-9:  # yfinance fallback collision
            continue
        if wpx < min_warrant_px or cpx <= 0:
            continue
        s1 = float(sigma_1y.get(r_["common"], np.nan))
        s3 = float(sigma_3m.get(r_["common"], np.nan))
        if not np.isfinite(s1) or s1 <= 0:
            continue
        sigma = min(s1, s3) if np.isfinite(s3) else s1
        sigma = max(sigma_floor, min(sigma, sigma_cap))
        bs = bs_call(cpx, strike, T_years, r, sigma)
        if bs < min_warrant_px:
            continue
        theoretical = dilution * bs
        gap_pct = (wpx - theoretical) / theoretical
        moneyness = cpx / strike
        rows.append({
            "common": r_["common"],
            "warrant": r_["warrant"],
            "common_px": cpx,
            "warrant_px": wpx,
            "moneyness": moneyness,
            "sigma_1y": s1,
            "sigma_3m": s3 if np.isfinite(s3) else None,
            "sigma_used": sigma,
            "days_above_18": int(days_above_18.get(r_["common"], 0)),
            "bs_call": bs,
            "theoretical": theoretical,
            "gap_pct": gap_pct,
            "security_name": r_.get("security_name", ""),
        })
    out = pd.DataFrame(rows)
    if out.empty:
        return out
    out["redemption_risk"] = (out["moneyness"] >= 1.0) | (out["days_above_18"] > 0)
    return out.sort_values("gap_pct").reset_index(drop=True)


def filter_real_arbs(fair_df: pd.DataFrame,
                     max_moneyness: float = 0.85,
                     min_theoretical: float = 0.50,
                     max_gap_pct: float = -0.70,
                     sigma_low: float = 0.40,
                     sigma_high: float = 1.50) -> pd.DataFrame:
    """The 'discount no longer makes sense' shortlist: warrant deeply
    OTM (no redemption-cap pressure), reasonable vol, meaningful
    theoretical fair value, and large negative gap.
    """
    if fair_df.empty:
        return fair_df
    return fair_df[
        (fair_df["moneyness"] <= max_moneyness)
        & (fair_df["days_above_18"] == 0)
        & (fair_df["sigma_1y"].between(sigma_low, sigma_high))
        & (fair_df["theoretical"] >= min_theoretical)
        & (fair_df["gap_pct"] <= max_gap_pct)
    ].copy().reset_index(drop=True)


# ---------- business quality + recent inflection scoring ----------

def fetch_fundamentals(commons: list[str]) -> pd.DataFrame:
    """Pull yfinance.info snapshots for a list of common tickers."""
    rows = []
    for c in commons:
        try:
            info = yf.Ticker(c).info or {}
        except Exception:
            info = {}
        rows.append({
            "common": c,
            "totalRevenue": info.get("totalRevenue"),
            "revenueGrowth": info.get("revenueGrowth"),
            "grossMargins": info.get("grossMargins"),
            "operatingMargins": info.get("operatingMargins"),
            "totalCash": info.get("totalCash"),
            "totalDebt": info.get("totalDebt"),
            "freeCashflow": info.get("freeCashflow"),
            "operatingCashflow": info.get("operatingCashflow"),
            "marketCap": info.get("marketCap"),
            "sharesOutstanding": info.get("sharesOutstanding"),
            "earningsQuarterlyGrowth": info.get("earningsQuarterlyGrowth"),
            "recommendationMean": info.get("recommendationMean"),
            "numberOfAnalystOpinions": info.get("numberOfAnalystOpinions"),
        })
    return pd.DataFrame(rows)


def score_quality_and_inflection(df: pd.DataFrame) -> pd.DataFrame:
    """Score business quality and recent positive inflection from fundamentals.

    quality = revenue traction + margin profile + cash runway.
    inflection = sequential growth + EPS surprise + analyst coverage.
    Penalize negative YoY revenue growth (no positive inflection by def).
    Caps absurd outliers (e.g. yfinance occasionally reports growth = 23775).
    """
    out = df.copy()

    def rev_score(r):
        rev = r.get("totalRevenue") or 0
        g = r.get("revenueGrowth")
        s = 0.0
        if rev >= 50e6: s += 1.0
        elif rev >= 10e6: s += 0.5
        elif rev >= 1e6: s += 0.2
        if g is not None and not pd.isna(g):
            g = max(min(g, 3.0), -1.0)  # cap data errors
            if g > 0:
                s += min(2.0, g * 3)
        return s

    def margin_score(r):
        gm = r.get("grossMargins")
        om = r.get("operatingMargins")
        s = 0.0
        if gm is not None and not pd.isna(gm) and gm > 0:
            s += gm * 2
        if om is not None and not pd.isna(om) and om > -0.20:
            s += 0.5
        return s

    def runway_score(r):
        cash = r.get("totalCash") or 0
        fcf = r.get("freeCashflow")
        if fcf is None or pd.isna(fcf) or fcf >= 0:
            return 1.5 if cash > 100e6 else (1.0 if cash > 25e6 else 0.5)
        burn_q = abs(fcf) / 4
        if burn_q <= 0: return 0.5
        q = cash / burn_q
        if q >= 8: return 1.5
        if q >= 4: return 1.0
        if q >= 2: return 0.5
        return 0.0

    def inflection_score(r):
        s = 0.0
        # penalize declining revenue YoY — no positive inflection by definition
        g = r.get("revenueGrowth")
        if g is not None and not pd.isna(g):
            g = max(min(g, 3.0), -1.0)
            if g < 0: s -= 0.5
        eg = r.get("earningsQuarterlyGrowth")
        if eg is not None and not pd.isna(eg):
            eg = max(min(eg, 5.0), -1.0)
            if eg > 0:
                s += min(2.0, eg * 0.5)
        rec = r.get("recommendationMean")
        if rec is not None and not pd.isna(rec) and 1.0 <= rec <= 2.5:
            s += 1.0
        n = r.get("numberOfAnalystOpinions") or 0
        if n >= 3: s += 0.5
        return s

    out["rev_score"] = out.apply(rev_score, axis=1)
    out["margin_score"] = out.apply(margin_score, axis=1)
    out["runway_score"] = out.apply(runway_score, axis=1)
    out["quality"] = out[["rev_score", "margin_score", "runway_score"]].sum(axis=1)
    out["inflection"] = out.apply(inflection_score, axis=1)
    return out


def rank_discount_quality_inflection(fair_df: pd.DataFrame,
                                     gap_threshold: float = -0.50,
                                     max_moneyness: float = 0.90,
                                     top_n_to_score: int = 60) -> pd.DataFrame:
    """End-to-end: take BS fair-value scan, filter to deep-discount survivors,
    pull fundamentals, score quality + inflection, rank by composite.

    composite = (-gap_pct) * (1 + quality) * max(0, 1 + inflection)

    A declining-revenue name with no other inflection signals gets
    inflection <= 0 -> composite collapses, so 'positive inflections'
    actually matter.
    """
    if fair_df.empty:
        return pd.DataFrame()
    deep = fair_df[
        (fair_df["gap_pct"] <= gap_threshold)
        & (fair_df["moneyness"] <= max_moneyness)
        & (fair_df["days_above_18"] == 0)
    ].copy()
    deep = deep.sort_values("gap_pct").head(top_n_to_score)
    if deep.empty:
        return deep
    fundamentals = fetch_fundamentals(deep["common"].unique().tolist())
    scored = score_quality_and_inflection(fundamentals)
    merged = deep.merge(scored, on="common", how="left")
    merged["composite"] = (
        (-merged["gap_pct"])
        * (1.0 + merged["quality"].fillna(0))
        * (1.0 + merged["inflection"].fillna(0)).clip(lower=0)
    )
    return merged.sort_values("composite", ascending=False).reset_index(drop=True)


# ---------- Streamlit UI ----------

def _plot(sig: pd.DataFrame, infl: pd.DataFrame, title: str) -> go.Figure:
    has_vol = "warrant_vol" in sig.columns
    rows = 4 if has_vol else 3
    heights = [0.28, 0.22, 0.22, 0.28] if has_vol else [0.35, 0.3, 0.35]
    titles = [f"{title} — prices", "log(warrant/common)"]
    if has_vol:
        titles.append("volume z-scores")
    titles.append("price z-scores (composite + joint)")
    fig = make_subplots(rows=rows, cols=1, shared_xaxes=True,
                        row_heights=heights, subplot_titles=titles,
                        vertical_spacing=0.05)
    fig.add_trace(go.Scatter(x=sig.index, y=sig["common"], name="common"),
                  row=1, col=1)
    fig.add_trace(go.Scatter(x=sig.index, y=sig["warrant"], name="warrant"),
                  row=1, col=1)
    fig.add_trace(go.Scatter(x=sig.index, y=sig["log_ratio"], name="log ratio"),
                  row=2, col=1)

    z_row = 4 if has_vol else 3
    if has_vol:
        if "warrant_vol_z" in sig.columns:
            fig.add_trace(go.Scatter(x=sig.index, y=sig["warrant_vol_z"],
                                     name="warrant vol z"), row=3, col=1)
        if "w2c_vol_z" in sig.columns:
            fig.add_trace(go.Scatter(x=sig.index, y=sig["w2c_vol_z"],
                                     name="warrant/common vol z",
                                     line=dict(width=2)), row=3, col=1)
        fig.add_hline(y=2, line_dash="dot", line_color="orange", row=3, col=1)
        fig.add_hline(y=-2, line_dash="dot", line_color="orange", row=3, col=1)

    fig.add_trace(go.Scatter(x=sig.index, y=sig["ratio_z"], name="ratio z",
                             line=dict(dash="dot")), row=z_row, col=1)
    fig.add_trace(go.Scatter(x=sig.index, y=sig["resid_z"], name="resid z",
                             line=dict(dash="dash")), row=z_row, col=1)
    fig.add_trace(go.Scatter(x=sig.index, y=sig["composite_z"],
                             name="composite z", line=dict(width=2)),
                  row=z_row, col=1)
    if "joint_z" in sig.columns:
        fig.add_trace(go.Scatter(x=sig.index, y=sig["joint_z"],
                                 name="joint z (price+vol)",
                                 line=dict(width=3, color="purple")),
                      row=z_row, col=1)

    if not infl.empty:
        for kind, sym, color in [("peak", "triangle-down", "red"),
                                 ("trough", "triangle-up", "green"),
                                 ("zero_cross", "x", "grey")]:
            sub = infl[infl["kind"] == kind]
            if not sub.empty:
                fig.add_trace(go.Scatter(
                    x=sub["date"], y=sub["z"], mode="markers", name=kind,
                    marker=dict(symbol=sym, size=10, color=color),
                ), row=z_row, col=1)

    fig.add_hline(y=2, line_dash="dot", line_color="red", row=z_row, col=1)
    fig.add_hline(y=-2, line_dash="dot", line_color="green", row=z_row, col=1)
    fig.add_hline(y=0, line_dash="dash", line_color="grey", row=z_row, col=1)
    fig.update_layout(height=850 if has_vol else 750, showlegend=True,
                      hovermode="x unified")
    return fig


def _pair_tab(lookback_w: int, lookback_m: int, prominence: float, z_alert: float):
    st.subheader("Single pair scan")
    source = st.radio("Data source", ["Yahoo Finance", "Upload CSV"],
                      horizontal=True, key="pair_source")

    pair_df = st.session_state.get("pair_df")
    pair_name = st.session_state.get("pair_name")

    if source == "Yahoo Finance":
        c1, c2, c3, c4 = st.columns([2, 2, 1, 1])
        common_ticker = c1.text_input("Common ticker", value="LCID",
                                      key="pair_common")
        warrant_ticker = c2.text_input("Warrant ticker", value="LCIDW",
                                       key="pair_warrant")
        period = c3.selectbox("History", ["1y", "2y", "5y", "10y", "max"],
                              index=2, key="pair_period")
        if c4.button("Fetch", use_container_width=True, key="pair_fetch"):
            try:
                pair_df = load_pair_yf(common_ticker, warrant_ticker,
                                       period=period)
                pair_name = f"{warrant_ticker} vs {common_ticker}"
                st.session_state["pair_df"] = pair_df
                st.session_state["pair_name"] = pair_name
            except Exception as e:
                st.error(f"Fetch failed: {e}")
    else:
        upl = st.file_uploader("CSV with columns: date, common, warrant",
                               type="csv", key="pair_upload")
        if upl is not None:
            df = pd.read_csv(upl)
            date_col = next((c for c in df.columns
                             if c.lower() in ("date", "time")),
                            df.columns[0])
            df[date_col] = pd.to_datetime(df[date_col])
            df = df.set_index(date_col).sort_index()
            pair_df = df[["common", "warrant"]].dropna()
            pair_name = upl.name
            st.session_state["pair_df"] = pair_df
            st.session_state["pair_name"] = pair_name

    if pair_df is None or pair_df.empty:
        st.info("Load a pair to begin.")
        return

    st.subheader(f"Pair: {pair_name}")
    st.write(f"Daily bars: {len(pair_df)} — {pair_df.index[0].date()} → "
             f"{pair_df.index[-1].date()}")

    scan = scan_pair(pair_df,
                     lookbacks={"Weekly": lookback_w, "Monthly": lookback_m},
                     prominence=prominence)
    if not scan:
        st.warning("Not enough data for the chosen lookbacks.")
        return

    summary = summarize(scan)
    st.subheader("Current readings")
    st.dataframe(summary, use_container_width=True)

    hot = summary[summary["composite_z"].abs() >= z_alert]
    if not hot.empty:
        st.error("ALERT — dislocation thresholds breached:")
        st.dataframe(hot, use_container_width=True)

    for tf, payload in scan.items():
        st.markdown(f"### {tf} timeframe")
        sig = payload["signals"]
        infl = payload["inflections"]
        vol_anom = payload.get("vol_anomalies", pd.DataFrame())
        st.plotly_chart(_plot(sig, infl, tf), use_container_width=True)
        c_l, c_r = st.columns(2)
